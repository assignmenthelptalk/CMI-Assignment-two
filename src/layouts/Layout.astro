---
import SocialShareSidebar from '../components/SocialShareSidebar.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { levels, guides, services } from '../data/navMenu.js';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  pageSchema?: object | object[];
  compactFooter?: boolean;
  noindex?: boolean;
  hideShareSidebar?: boolean;
}

const { title, description, canonical, pageSchema, compactFooter = false, noindex = false, hideShareSidebar = false } = Astro.props;

const legalLinks = [
  { href: 'https://www.cmiassignmenthelp.uk.com/privacy-policy/', label: 'Privacy Policy' },
  { href: 'https://www.cmiassignmenthelp.uk.com/terms-and-conditions/', label: 'Terms and Conditions' },
  { href: 'https://www.cmiassignmenthelp.uk.com/refund-policy/', label: 'Refund Policy' },
  { href: 'https://www.cmiassignmenthelp.uk.com/academic-integrity/', label: 'Academic Integrity' },
];

const siteUrl = 'https://www.cmiassignmenthelp.uk.com';
const whatsappUrl = 'https://wa.me/447916696894';

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "CMI Assignment Help UK",
  "url": siteUrl,
  "description": "Independent UK-based CMI assignment writing and tutoring service for working professionals studying Chartered Management Institute qualifications at Levels 3 to 7.",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "Customer Service",
    "availableLanguage": "English"
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "CMI Assignment Help UK",
  "url": siteUrl
};

const canonicalHref = canonical ?? siteUrl;

// Home > own hub > unit for units; Home > page for everything else. No trail on the home page.
const breadcrumbSchema = (() => {
  const path = new URL(canonicalHref).pathname.replace(/\/+$/, '');
  if (!path) return null;
  const unit = path.match(/^\/cmi-(\d{3,4})-assignment-help$/);
  const hub = path.match(/^\/cmi-level-(\d)-assignment-help$/);
  const trail = [{ name: 'Home', url: `${siteUrl}/` }];
  if (unit) {
    const code = unit[1];
    const level = code.length === 4 ? 4 : Number(code[0]);
    trail.push({ name: `CMI Level ${level} Assignment Help`, url: `${siteUrl}/cmi-level-${level}-assignment-help/` });
    trail.push({ name: `CMI Unit ${code} Assignment Help`, url: `${siteUrl}${path}/` });
  } else {
    const name = hub ? `CMI Level ${hub[1]} Assignment Help` : title.split(/\s[|—–-]\s/)[0].trim();
    trail.push({ name, url: `${siteUrl}${path}/` });
  }
  return {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": trail.map((c, i) => ({ "@type": "ListItem", "position": i + 1, "name": c.name, "item": c.url })),
  };
})();

const extraSchemas = pageSchema
  ? (Array.isArray(pageSchema) ? pageSchema : [pageSchema])
  : [];
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="-oKuyb-HutHX2tQUkpi1JYzQ6PiFv-jfqjPfXABJcBY" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalHref} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {extraSchemas.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <CookieBanner />

    <header class="site-header">
      <div class="container header-inner">
        <a href="https://www.cmiassignmenthelp.uk.com/" class="logo" aria-label="CMI Assignment Help UK — Home">
          cmiassignmenthelp.uk.com
        </a>

        <nav class="main-nav" aria-label="Main navigation">
          <ul class="nav-list">
            <li class="nav-item has-dropdown">
              <button class="nav-toggle" aria-expanded="false" aria-haspopup="true">
                Levels <span class="caret" aria-hidden="true">▾</span>
              </button>
              <ul class="dropdown" role="menu">
                {levels.map((level) => (
                  <li><a href={level.slug} role="menuitem">CMI {level.label} assignment help</a></li>
                ))}
              </ul>
            </li>
            <li class="nav-item has-dropdown">
              <button class="nav-toggle" aria-expanded="false" aria-haspopup="true">
                Guides <span class="caret" aria-hidden="true">▾</span>
              </button>
              <div class="dropdown mega" role="menu">
                <ul class="mega-cols">
                  {guides.map((g) => (
                    <li><a href={g.slug} role="menuitem">{g.title}</a></li>
                  ))}
                </ul>
              </div>
            </li>
            <li class="nav-item has-dropdown">
              <button class="nav-toggle" aria-expanded="false" aria-haspopup="true">
                Services <span class="caret" aria-hidden="true">▾</span>
              </button>
              <ul class="dropdown" role="menu">
                {services.map((s) => (
                  <li><a href={s.slug} role="menuitem">{s.title}</a></li>
                ))}
              </ul>
            </li>
          </ul>
        </nav>

        <a
          href={whatsappUrl}
          class="btn btn-whatsapp"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contact us on WhatsApp for CMI assignment help"
        >
          WhatsApp Us
        </a>

        <button
          class="hamburger"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Open menu"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <div class="mobile-nav-backdrop"></div>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation">
      <button class="mobile-nav-close" aria-label="Close menu">✕</button>
      <ul class="mobile-nav-list" id="mobile-nav-list"></ul>
      <a
        href={whatsappUrl}
        class="btn btn-whatsapp mobile-whatsapp"
        target="_blank"
        rel="noopener noreferrer"
      >
        WhatsApp Us
      </a>
    </nav>

    <main>
      <slot />
    </main>

    {!hideShareSidebar && <SocialShareSidebar pageUrl={canonicalHref} pageTitle={title} />}

    <footer class="site-footer">
      {compactFooter ? (
        <div class="container footer-grid footer-grid--compact">
          <div class="footer-col">
            <p class="footer-brand"><a href="https://www.cmiassignmenthelp.uk.com/">CMI Assignment Help UK</a></p>
            <p class="footer-desc">
              UK-based CMI writers supporting working professionals across all levels 3 to 7.
            </p>
          </div>

          <div class="footer-col">
            <h3 class="footer-heading">Quick links</h3>
            <ul class="footer-links">
              <li><a href="https://www.cmiassignmenthelp.uk.com/#how-cmi-assignment-help-works">How it works</a></li>
              <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-assignment-tutoring/">CMI Assignment Tutoring</a></li>
              <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-assignment-help-online/">CMI Assignment Help Online</a></li>
            </ul>
            <h3 class="footer-heading footer-heading--legal">Legal</h3>
            <ul class="footer-links">
              {legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
              <li><button type="button" class="cookie-settings-link" data-cookie-settings hidden>Cookie settings</button></li>
            </ul>
          </div>
        </div>
      ) : (
        <div class="container footer-grid">
          <div class="footer-col">
            <p class="footer-brand"><a href="https://www.cmiassignmenthelp.uk.com/">CMI Assignment Help UK</a></p>
            <p class="footer-desc">
              UK-based CMI writers supporting working professionals across all levels 3 to 7.
              CMI assignment help, writing service, and tutoring for every CMI qualification pathway.
            </p>
            <a
              href={whatsappUrl}
              class="btn btn-whatsapp footer-cta"
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp Us Now
            </a>
          </div>

          <div class="footer-col">
            <h3 class="footer-heading">CMI Levels</h3>
            <ul class="footer-links">
              <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-level-3-assignment-help/">CMI Level 3 Assignment Help</a></li>
              <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-level-4-assignment-help/">CMI Level 4 Assignment Help</a></li>
              <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-level-5-assignment-help/">CMI Level 5 Assignment Help</a></li>
              <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-level-6-assignment-help/">CMI Level 6 Assignment Help</a></li>
              <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-level-7-assignment-help/">CMI Level 7 Assignment Help</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h3 class="footer-heading">Guides</h3>
            <ul class="footer-links">
              <li><a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-qualification-levels-explained/">CMI Qualification Levels Explained</a></li>
              <li><a href="https://www.cmiassignmenthelp.uk.com/guides/is-cmi-qualification-worth-it/">Is a CMI Qualification Worth It?</a></li>
              <li><a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-command-verbs-explained/">CMI Command Verbs Explained</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h3 class="footer-heading">Legal</h3>
            <ul class="footer-links">
              {legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
              <li><button type="button" class="cookie-settings-link" data-cookie-settings hidden>Cookie settings</button></li>
            </ul>
          </div>
        </div>
      )}

      <div class="footer-bottom">
        <div class="container">
          <p class="footer-disclaimer">
            Independent service. Not affiliated with or endorsed by the Chartered Management Institute (CMI).
          </p>
          <p>
            &copy; {new Date().getFullYear()} CMI Assignment Help UK &mdash;
            UK-based CMI writers &mdash; All levels 3 to 7 &mdash;
            CMI assignment help for working professionals
          </p>
        </div>
      </div>
    </footer>

    <script>
      const toggles = document.querySelectorAll<HTMLButtonElement>('.nav-toggle');
      toggles.forEach(btn => {
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          toggles.forEach(other => other.setAttribute('aria-expanded', 'false'));
          btn.setAttribute('aria-expanded', String(!expanded));
        });
      });
      document.addEventListener('click', (e) => {
        toggles.forEach(btn => {
          if (!btn.closest('.has-dropdown')?.contains(e.target as Node)) {
            btn.setAttribute('aria-expanded', 'false');
          }
        });
      });

      const hamburger = document.querySelector<HTMLButtonElement>('.hamburger');
      const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');
      const backdrop = document.querySelector<HTMLElement>('.mobile-nav-backdrop');
      const closeBtn = document.querySelector<HTMLButtonElement>('.mobile-nav-close');

      // The drawer is empty in the HTML so crawlers see one set of nav links; build it from the desktop nav.
      function buildMobileNav() {
        const list = document.getElementById('mobile-nav-list');
        if (!list || list.childElementCount > 0) return;
        document.querySelectorAll('.main-nav .nav-item.has-dropdown').forEach((item) => {
          const label = item.querySelector('.nav-toggle')?.firstChild?.textContent?.trim();
          if (!label) return;
          const details = document.createElement('details');
          const summary = document.createElement('summary');
          summary.textContent = label;
          const sub = document.createElement('ul');
          item.querySelectorAll('.dropdown a').forEach((a) => {
            const li = document.createElement('li');
            const link = document.createElement('a');
            link.href = a.getAttribute('href') ?? '';
            link.textContent = a.textContent?.trim() ?? '';
            li.appendChild(link);
            sub.appendChild(li);
          });
          details.append(summary, sub);
          const li = document.createElement('li');
          li.appendChild(details);
          list.appendChild(li);
        });
      }

      function openMobileNav() {
        buildMobileNav();
        mobileNav?.classList.add('open');
        backdrop?.classList.add('open');
        hamburger?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
      function closeMobileNav() {
        mobileNav?.classList.remove('open');
        backdrop?.classList.remove('open');
        hamburger?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
      hamburger?.addEventListener('click', () => {
        const expanded = hamburger.getAttribute('aria-expanded') === 'true';
        expanded ? closeMobileNav() : openMobileNav();
      });
      closeBtn?.addEventListener('click', closeMobileNav);
      backdrop?.addEventListener('click', closeMobileNav);
    </script>

  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --navy:       #0f2a4a;
    --blue:       #1e4d8c;
    --blue-light: #2563eb;
    --green:      #25D366;
    --green-dark: #1da851;
    --text:       #1f2937;
    --text-muted: #6b7280;
    --bg:         #ffffff;
    --bg-light:   #f8fafc;
    --border:     #e2e8f0;
    --radius:     6px;
    --shadow:     0 2px 8px rgba(0,0,0,.08);
    --font:       system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text);
    background: var(--bg);
  }

  .container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  a {
    color: var(--blue-light);
    text-decoration: none;
  }
  a:hover { text-decoration: underline; }

  /* ── Buttons ── */
  .btn {
    display: inline-block;
    padding: .65rem 1.4rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: .95rem;
    cursor: pointer;
    transition: background .15s, transform .1s;
    text-decoration: none;
    border: none;
  }
  .btn-whatsapp {
    background: var(--green);
    color: #fff;
  }
  .btn-whatsapp:hover {
    background: var(--green-dark);
    color: #fff;
    text-decoration: none;
    transform: translateY(-1px);
  }
  .btn-primary {
    background: var(--blue);
    color: #fff;
  }
  .btn-primary:hover {
    background: var(--navy);
    color: #fff;
    text-decoration: none;
    transform: translateY(-1px);
  }

  /* ── Header ── */
  .site-header {
    background: var(--navy);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 6px rgba(0,0,0,.3);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 64px;
  }

  .logo {
    color: #c4b5fd;
    background: linear-gradient(90deg, #93c5fd 0%, #c4b5fd 50%, #f0abfc 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -.01em;
    white-space: nowrap;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo:hover { filter: brightness(1.15); text-decoration: none; }

  .main-nav { flex: 1; }
  .nav-list {
    display: flex;
    align-items: center;
    gap: .25rem;
    list-style: none;
  }

  .nav-item > a,
  .nav-toggle {
    color: #d1d5db;
    font-size: .875rem;
    font-weight: 500;
    padding: .4rem .75rem;
    border-radius: 4px;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: .25rem;
    white-space: nowrap;
    font-family: inherit;
    transition: color .15s, background .15s;
    text-decoration: none;
  }
  .nav-item > a:hover,
  .nav-toggle:hover {
    color: #fff;
    background: rgba(255,255,255,.1);
    text-decoration: none;
  }

  /* dropdown */
  .has-dropdown { position: relative; }
  .dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    list-style: none;
    min-width: 240px;
    z-index: 200;
    padding: .4rem 0;
  }
  .dropdown li a {
    display: block;
    padding: .55rem 1rem;
    font-size: .875rem;
    color: var(--text);
    white-space: nowrap;
  }
  .dropdown li a:hover {
    background: var(--bg-light);
    text-decoration: none;
  }
  .nav-toggle[aria-expanded="true"] + .dropdown { display: block; }

  /* mega dropdown (Level 3-7 units, Guides) */
  .dropdown.mega {
    left: 50%;
    transform: translateX(-50%);
    width: 720px;
    max-width: 92vw;
    padding: .75rem 1rem 1rem;
  }
  .mega-view-all {
    display: block;
    padding: .5rem .75rem;
    font-size: .85rem;
    font-weight: 700;
    color: var(--blue-light);
    border-bottom: 1px solid var(--border);
    margin-bottom: .5rem;
    white-space: normal;
  }
  .mega-view-all:hover { background: var(--bg-light); text-decoration: none; }
  .mega-cols {
    column-width: 230px;
    column-gap: 1.25rem;
    max-height: 65vh;
    overflow-y: auto;
    list-style: none;
  }
  .mega-cols li { break-inside: avoid; }
  .mega-cols li a {
    padding: .4rem .6rem;
    font-size: .82rem;
    line-height: 1.4;
    white-space: normal;
  }

  /* hamburger (mobile only) */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
  }
  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform .2s, opacity .2s;
  }
  .hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .hamburger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* mobile off-canvas nav */
  .mobile-nav-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15,42,74,.5);
    z-index: 300;
  }
  .mobile-nav-backdrop.open { display: block; }

  .mobile-nav {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 85vw);
    background: #fff;
    z-index: 400;
    padding: 1.25rem;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform .25s ease;
  }
  .mobile-nav.open {
    display: block;
    transform: translateX(0);
  }
  .mobile-nav-close {
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    margin-bottom: 1rem;
    color: var(--navy);
  }
  .mobile-nav-list { list-style: none; }
  .mobile-nav-list > li {
    border-bottom: 1px solid var(--border);
  }
  .mobile-nav-list summary {
    padding: .85rem .25rem;
    font-weight: 600;
    color: var(--navy);
    cursor: pointer;
  }
  .mobile-view-all {
    display: block;
    padding: .4rem .5rem;
    font-size: .82rem;
    font-weight: 700;
    color: var(--blue-light);
  }
  .mobile-nav-list ul {
    list-style: none;
    padding-bottom: .5rem;
  }
  .mobile-nav-list ul li a {
    display: block;
    padding: .4rem .75rem;
    font-size: .82rem;
    color: var(--text);
  }
  .mobile-whatsapp {
    display: block;
    text-align: center;
    margin-top: 1rem;
  }

  /* ── Footer ── */
  .site-footer {
    background: var(--navy);
    color: #d1d5db;
    margin-top: 4rem;
    padding-top: 3rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: 2rem;
  }
  .footer-grid--compact { grid-template-columns: 2fr 1fr; }
  .footer-brand {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: .75rem;
  }
  .footer-brand a { color: inherit; text-decoration: none; }
  .footer-brand a:hover { text-decoration: underline; }
  .footer-desc {
    font-size: .875rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .footer-cta { font-size: .875rem; }
  .footer-heading {
    color: #fff;
    font-size: .8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-bottom: .75rem;
  }
  .footer-heading--legal { margin-top: 1.25rem; }
  .footer-disclaimer { margin-bottom: .35rem; }
  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .45rem;
  }
  .footer-links a {
    color: #9ca3af;
    font-size: .875rem;
    text-decoration: none;
  }
  .footer-links a:hover { color: #fff; text-decoration: underline; }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,.1);
    padding: 1.25rem 0;
  }
  .footer-bottom p {
    font-size: .8rem;
    color: #6b7280;
    text-align: center;
  }

  /* ── Page header image ── */
  .page-header-img {
    display: block;
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    height: auto;
    border-radius: var(--radius);
  }

  /* ── Utility ── */
  .section { padding: 4rem 0; }
  .section-alt { background: var(--bg-light); }
  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: .5rem;
  }
  .section-lead {
