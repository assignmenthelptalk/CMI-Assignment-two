---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';

const whatsappUrl = 'https://wa.me/447916696894';
const siteUrl = 'https://www.cmiassignmenthelp.uk.com';


const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is included in CMI report writing help?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CMI report writing help covers written work where your brief asks for a report: a clear structure, analysis written to the command verb of each assessment criterion (such as Analyse, Examine or Evaluate at Level 5), recommendations that follow from the analysis, and a consistently referenced reference list. It is available as a complete report written from your unit brief, or as help with specific sections if you have already written most of it yourself."
      }
    },
    {
      "@type": "Question",
      "name": "Can you just rewrite my executive summary or recommendations, not the whole report?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Section-specific help is available if you have written most of the report and need one part brought up to standard, most commonly the executive summary, the recommendations or the referencing. Send your draft and unit brief via WhatsApp, say which section needs attention, and the quote will reflect that narrower scope."
      }
    },
    {
      "@type": "Question",
      "name": "How many sources does a CMI report need?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The unit specifications don't set a minimum number of sources. The Level 4 to 7 syllabuses ask for appropriate use of evidence, examples and references to support conclusions and recommendations. Your centre or brief may state its own expectation, so follow that. Every source cited in the text must appear in the reference list, and the list should not include sources you never cited."
      }
    },
    {
      "@type": "Question",
      "name": "Does my CMI assignment have to be a report?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not necessarily. CMI does not prescribe a single format: centres set the format within CMI's recommendations, and written work (reports, accounts, reflective pieces) forms the majority of the evidence. Your brief says what is required. If it asks for a report, the page above explains how to approach it; if it asks for something else, send it over and we will work to that."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between report writing help and CMI assignment tutoring?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Report writing help produces or corrects the report itself, either the complete document or specific sections, delivered as finished content. CMI assignment tutoring is coaching where the student writes the report and the tutor guides structure, command verb depth and draft review, with the student keeping authorship. If you want a section written for you, use report writing help; if you want to write it yourself with expert direction, use tutoring."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "CMI Report Writing Help",
  "description": "CMI report writing help for assignments where the brief asks for a report: structure, analysis written to the command verb, recommendations that follow from the analysis, and consistent referencing.",
  "provider": {
    "@type": "Organization",
    "name": "CMI Assignment Help UK",
    "url": siteUrl
  },
  "areaServed": "United Kingdom",
  "serviceType": "Academic Writing Service"
};

const reportSections = [
  { num: "1", title: "Executive Summary", alert: true, desc: "Only if the brief or your centre asks for one. It summarises what the report found and recommends, rather than introducing the topic." },
  { num: "2", title: "Main Analysis Sections", alert: false, desc: "Usually the largest share of the word count. Each assessment criterion is answered to its command verb, using your own organisation as the case." },
  { num: "3", title: "Recommendations", alert: false, desc: "Practical actions that follow from your findings, each traceable to the analysis that supports it." },
  { num: "4", title: "Reference List", alert: false, desc: "A consistent list of the sources you actually cited, matched to the in-text citations." },
];
---

<Layout
  title="CMI Report Writing Help | Structure, Analysis, Referencing"
  description="CMI report writing help when your brief asks for a report: structure, analysis written to the command verb, recommendations and referencing. WhatsApp quote in 2 hours."
  canonical={siteUrl + '/cmi-report-writing-help/'}
  pageSchema={[serviceSchema, faqSchema]}
>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Report Format &bull; Levels 3 to 7</p>
      <h1>CMI Report Writing Help | Reports Written to Your Brief and Criteria</h1>
      <p class="hero-sub">
        Support for CMI assignments where the brief asks for a report. We help with structure, analysis written to
        the command verb of each criterion, recommendations that follow from the evidence, and consistent
        referencing. Full report writing or help with specific sections, priced according to scope.
      </p>
      <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
        Get CMI Report Writing Help
      </a>
      <p class="hero-note">Fixed quote within 2 hours &bull; Full report or single sections</p>
    </div>
  </section>

  <TableOfContents />

  <!-- What's Covered -->
  <section class="section">
    <div class="container">
      <h2 class="section-title" id="what-cmi-report-writing-help-covers">What CMI Report Writing Help Covers</h2>
      <p class="section-lead">
        Scoped to assignments where your brief asks for a report. This service is offered by
        <a href="https://www.cmiassignmenthelp.uk.com/">CMI Assignment Help UK</a> across every CMI level from 3 to 7.</p>
      <ul class="includes-list">
        <li>
          <strong>Structure and planning</strong>: headings that map to the assessment criteria in your unit,
          and a word count split that matches where the marks are earned.
        </li>
        <li>
          <strong>Analysis section development</strong>: written to the command verb of each criterion, for
          example Analyse, Examine or Evaluate at Level 5, applying named management theory to your
          organisational context.
        </li>
        <li>
          <strong>Recommendations</strong>: practical actions derived directly from specific findings, with a
          timeline or measure where it helps.
        </li>
        <li>
          <strong>Executive summary</strong>: if your brief or centre asks for one, written last so it reflects
          what the report actually found.
        </li>
        <li>
          <strong>Referencing</strong>: a consistent reference list matched to your in-text citations, in the
          style your centre requires.
        </li>
      </ul>
      <p>
        Available as <strong>full report writing</strong> (a CMI-qualified writer produces the complete
        report from your unit brief) or as <strong>section-specific help</strong> for students who have written
        most of the report independently but need one part corrected, most commonly the executive summary, the
        recommendations or the referencing.
      </p>
      <p>
        This is distinct from the <a href="https://www.cmiassignmenthelp.uk.com/cmi-assignment-writing-service/">CMI assignment writing service</a>,
        which covers every format including reflective accounts and scenario-based answers, and from
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-assignment-tutoring/">CMI assignment tutoring</a>, where the student retains authorship
        and the tutor provides guidance rather than producing content.
      </p>
    </div>
  </section>

  <!-- When the brief asks for a report -->
  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="when-the-brief-asks-for-a-report">When Your Brief Asks for a Report</h2>
      <p>
        CMI does not prescribe one assignment format. Centres set the format within CMI's recommendations, and
        written work forms the majority of the evidence, so reports, accounts and reflective pieces all appear. Your
        brief is the authority on what to submit, and the layout below is our own practical advice, not a CMI
        template.
      </p>
      <p>
        A common mistake is writing a report like an essay: an introduction that previews conclusions, headings
        that do not map to the criteria, and no clear recommendations. Whatever the layout, the assessor needs to
        see each criterion answered to its verb, with evidence.
      </p>
      <p class="report-sections-lead">
        Four parts of a report usually decide how it reads. They are shown below in the order a reader meets them:
      </p>
      <div class="report-sections">
        {reportSections.map(s => (
          <div class={`report-section ${s.alert ? 'report-section--alert' : ''}`}>
            <div class="rs-num">{s.num}</div>
            <div class="rs-body">
              <h3 class="rs-title">{s.title}{s.alert && <span class="rs-alert">Often misunderstood</span>}</h3>
              <p class="rs-desc">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <p>
        For a fuller layout, a word count method and the common errors, see the
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-assignment-structure/">CMI assignment structure guide</a>.
      </p>
    </div>
  </section>

  <!-- Executive Summary -->
  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="executive-summary-writing">Executive Summary Writing</h2>
      <p>
        Not every CMI brief asks for an executive summary, so check yours. When one is required, it is written last,
        after every other section is complete, and placed first. It summarises the report's key findings and
        recommendations. It is not an introduction to the topic. Check whether your brief counts it toward the
        word limit.
      </p>
      <div class="es-compare">
        <div class="es-col es-col--wrong">
          <h3>What It Is Not</h3>
          <p>"This report will examine leadership approaches with reference to Kotter's change framework..." (an introduction sentence describing what the report will do).</p>
        </div>
        <div class="es-col es-col--right">
          <h3>What It Is</h3>
          <p>"Analysis of the leadership approach applied during the restructure indicates that the Directive style produced a measurable increase in voluntary turnover... Three recommendations are presented accordingly." (a summary of what the report found).</p>
        </div>
      </div>
      <p>
        The test: a reader who reads only the executive summary should understand what the report found and
        what it recommends. Help with this section typically involves drafting or rewriting it after the analysis
        and recommendations are finalised, since it must reflect the report's actual content rather than the
        original plan, which often changes during writing.
      </p>
    </div>
  </section>

  <!-- Analysis Sections -->
  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="analysis-sections-command-verbs">Analysis Sections: Writing to the Command Verb</h2>
      <p>
        The main analysis sections are where the assessment criteria are met. Each criterion in your unit begins with a
        command verb, and CMI defines each verb in Annex 1 of the syllabus. The analysis has to do what the verb asks,
        using theory as a tool on your own organisation rather than describing it.
      </p>
      <div class="verb-depth-grid">
        <div class="verb-depth-card">
          <h3>Level 5: Analyse, Examine, Evaluate</h3>
          <p>
            These three account for 165 of the 248 criteria at Level 5 (Analyse 66, Examine 51, Evaluate 48).
            Analyse breaks a situation into parts and examines each. Evaluate weighs strengths, weaknesses and
            arguments for and against, then reaches a reasoned judgement. A description of strengths and
            weaknesses with no stated conclusion does not meet Evaluate.
          </p>
        </div>
        <div class="verb-depth-card verb-depth-card--l6">
          <h3>Level 6: Critically appraise, Critically assess</h3>
          <p>
            Level 6 has 75 criteria, led by Critically appraise (12) and Critically assess (9), with Discuss (8) and
            Recommend (7) next. The Critically verbs ask you to question and test the evidence and argue a position,
            not just report it.
          </p>
        </div>
      </div>
      <p>
        Report writing help at this stage typically means restructuring analysis that describes a framework instead of
        applying it, adding a missing conclusion to an Evaluate section, or adding the questioning that a Critically
        verb requires. Our <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-command-verbs-explained/">command verbs guide</a>
        gives CMI's definitions in full.
      </p>
    </div>
  </section>

  <!-- Recommendations -->
  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="recommendations-from-the-analysis">Recommendations That Follow from the Analysis</h2>
      <p>
        Where a criterion asks you to Recommend or Develop a plan, the recommendation has to follow from your evidence.
        CMI does not require a particular recommendation format. A SMART layout is a useful checklist that many
        writers choose to apply:
      </p>
      <div class="smart-grid">
        <div class="smart-item"><h3>Specific</h3><p>Names a concrete action. "Improve communication" is vague. "Hold weekly one-to-ones from a stated date" is specific.</p></div>
        <div class="smart-item"><h3>Measurable</h3><p>Includes a success measure that can be checked against evidence.</p></div>
        <div class="smart-item"><h3>Achievable</h3><p>Realistic within the constraints established earlier in the analysis.</p></div>
        <div class="smart-item"><h3>Relevant</h3><p>Traceable directly to a specific finding, not introduced without an evidential basis.</p></div>
        <div class="smart-item"><h3>Time-bound</h3><p>Includes a timeline or review date for implementation.</p></div>
      </div>
      <p>
        A recommendation with no basis in the preceding analysis is unsupported, however well it is worded. Help
        with recommendations typically involves rewriting vague statements into specific actions and linking each
        one explicitly back to the finding that supports it.
      </p>
    </div>
  </section>

  <!-- References -->
  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="referencing-and-evidence">Referencing and Evidence</h2>
      <p>
        The Level 4 to 7 syllabuses ask for appropriate use of evidence, examples and references to support conclusions and recommendations. The unit specifications don't set a minimum number of sources, so follow your centre's guidance and your brief.
        Whatever style you use, apply it consistently.
      </p>
      <div class="ref-grid">
        <div class="ref-block">
          <h3>Fit the Claim</h3>
          <p>Each significant claim should rest on a source or on a specific example from your own organisation.</p>
        </div>
        <div class="ref-block">
          <h3>Mix Source Types</h3>
          <p>Books, journal articles, professional body publications and reputable organisational data all have a place when relevant.</p>
        </div>
        <div class="ref-block">
          <h3>In-Text Matching</h3>
          <p>Every reference list entry needs a matching in-text citation and vice versa, with no orphaned citations either way.</p>
        </div>
      </div>
      <p>
        Help with referencing covers correcting inconsistent formatting, checking that citations and the list match,
        and finding suitable sources where a draft leans on too few. See our
        <a href="https://www.cmiassignmenthelp.uk.com/guides/harvard-referencing-cmi/">Harvard referencing guide</a> if your centre uses Harvard.
      </p>
    </div>
  </section>

  <!-- By Level -->
  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="report-writing-help-by-level">CMI Report Writing Help by Level</h2>
      <div class="level-summary-grid">
        <div class="level-summary-card">
          <h3><a href="https://www.cmiassignmenthelp.uk.com/cmi-level-5-assignment-help/">CMI Level 5</a></h3>
          <p>
            Units 501 to 526, with a guideline of 3,000 to 5,000 words per unit and a 10% allowance. Criteria are
            mostly Analyse, Examine and Evaluate. The common request is analysis that reaches a stated conclusion.
          </p>
        </div>
        <div class="level-summary-card">
          <h3><a href="https://www.cmiassignmenthelp.uk.com/cmi-level-6-assignment-help/">CMI Level 6</a></h3>
          <p>
            Units 601 to 614. The Critically verbs lead, so the common request is analysis that tests the evidence
            and argues a position, rather than describing it.
          </p>
        </div>
        <div class="level-summary-card">
          <h3><a href="https://www.cmiassignmenthelp.uk.com/cmi-level-7-assignment-help/">CMI Level 7</a></h3>
          <p>
            Units 701 to 716, plus Group B units. Of 80 criteria, 37 begin with Critically, and many end in a
            proposal or strategy, so the work must judge the evidence and then recommend.
          </p>
        </div>
      </div>
      <p>
        CMI grades each unit Pass or Refer, so the aim of a report is to meet every criterion. See the
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-resubmission-guide/">resubmission guide</a> if a unit has been referred.
      </p>
    </div>
  </section>

  <!-- How to Get Help -->
  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="how-to-get-cmi-report-writing-help">How to Get CMI Report Writing Help</h2>
      <ol class="order-steps">
        <li>
          <strong>Message us on WhatsApp</strong> with your unit number, qualification level and full assignment
          brief. State whether you need the complete report written or section-specific help, for example the
          executive summary only, the recommendations only, or referencing correction only. Attach your current
          draft if one exists.
        </li>
        <li>
          <strong>Receive a fixed quote within 2 hours,</strong> priced according to scope. A full report
          costs more than a single-section correction.
        </li>
        <li>
          <strong>Receive your completed report or corrected sections</strong> in the agreed format and
          timeframe, written to your unit criteria and referenced in the style your centre uses.
        </li>
      </ol>
      <div class="order-cta">
        <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
          Message Us to Start
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="cmi-report-writing-help-faq">CMI Report Writing Help: Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-q">What is included in CMI report writing help?</summary>
          <div class="faq-a"><p>CMI report writing help covers written work where your brief asks for a report: a clear structure, analysis written to the command verb of each assessment criterion (such as Analyse, Examine or Evaluate at Level 5), recommendations that follow from the analysis, and a consistently referenced reference list. It is available as a complete report written from your unit brief, or as help with specific sections if you have already written most of it yourself.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can you just rewrite my executive summary or recommendations, not the whole report?</summary>
          <div class="faq-a"><p>Yes. Section-specific help is available if you have written most of the report and need one part brought up to standard, most commonly the executive summary, the recommendations or the referencing. Send your draft and unit brief via WhatsApp, say which section needs attention, and the quote will reflect that narrower scope.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">How many sources does a CMI report need?</summary>
          <div class="faq-a"><p>The unit specifications don't set a minimum number of sources. The Level 4 to 7 syllabuses ask for appropriate use of evidence, examples and references to support conclusions and recommendations. Your centre or brief may state its own expectation, so follow that. Every source cited in the text must appear in the reference list, and the list should not include sources you never cited.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Does my CMI assignment have to be a report?</summary>
          <div class="faq-a"><p>Not necessarily. CMI does not prescribe a single format: centres set the format within CMI's recommendations, and written work (reports, accounts, reflective pieces) forms the majority of the evidence. Your brief says what is required. If it asks for a report, the page above explains how to approach it; if it asks for something else, send it over and we will work to that.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">What is the difference between report writing help and CMI assignment tutoring?</summary>
          <div class="faq-a"><p>Report writing help produces or corrects the report itself, either the complete document or specific sections, delivered as finished content. CMI assignment tutoring is coaching where the student writes the report and the tutor guides structure, command verb depth and draft review, with the student keeping authorship. If you want a section written for you, use report writing help; if you want to write it yourself with expert direction, use tutoring.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Supplementary -->
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title" id="related-cmi-assignment-services">Related CMI Assignment Services</h2>
      <div class="supp-grid">
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-assignment-structure/" class="supp-card">
          <h3>CMI Assignment Structure Guide</h3>
          <p>Reports, accounts and reflective writing: a practical layout, word count planning and common errors.</p>
        </a>
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-5-assignment-help/" class="supp-card">
          <h3>CMI Level 5 Assignment Help</h3>
          <p>All 26 Level 5 units (501 to 526), with their criteria, verbs and word counts.</p>
        </a>
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-6-assignment-help/" class="supp-card">
          <h3>CMI Level 6 Assignment Help</h3>
          <p>The Critically verbs and the Level 6 unit set, 601 to 614.</p>
        </a>
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-assignment-tutoring/" class="supp-card">
          <h3>CMI Assignment Tutoring</h3>
          <p>For students who want to write their own report with expert guidance on structure and command verb depth.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="cta-section">
    <div class="container cta-inner">
      <h2>Get Your Report Written</h2>
      <p>Message us on WhatsApp with your unit number, level and deadline. Fixed quote in 2 hours, full report or specific sections only.</p>
      <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
        WhatsApp Us Your Brief
      </a>
    </div>
  </section>

</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--navy) 0%, var(--blue) 100%);
    color: #fff;
    padding: 5rem 0 4rem;
    text-align: center;
  }
  .hero-inner { max-width: 780px; margin: 0 auto; }
  .eyebrow {
    font-size: .8rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .08em; color: #93c5fd; margin-bottom: .75rem;
  }
  .hero h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800;
    color: #fff; margin-bottom: 1.25rem; line-height: 1.2;
  }
  .hero-sub { font-size: 1.05rem; color: #bfdbfe; margin-bottom: 2rem; line-height: 1.7; }
  .hero-note { font-size: .82rem; color: #93c5fd; margin-top: .75rem; }

  .narrow { max-width: 860px; }

  .includes-list {
    display: flex; flex-direction: column; gap: 1rem;
    list-style: none; padding: 0; margin-bottom: 1.5rem;
  }
  .includes-list li {
    padding: 1.25rem 1.5rem;
    background: var(--bg-light);
    border-left: 4px solid var(--blue);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: .95rem; line-height: 1.65;
  }

  .report-sections-lead { font-size: .95rem; color: var(--text-muted); margin: 1.5rem 0 1rem; }
  .report-sections { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem; }
  .report-section { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1rem 1.25rem; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .report-section--alert { border-color: var(--blue); background: #eff6ff; }
  .rs-num { font-size: 1.3rem; font-weight: 800; color: var(--blue); }
  .rs-title { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: .35rem; display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
  .rs-alert { font-size: .68rem; font-weight: 700; text-transform: uppercase; background: var(--green); color: #fff; padding: .15rem .5rem; border-radius: 20px; }
  .rs-desc { font-size: .88rem; color: var(--text-muted); line-height: 1.6; margin: 0; }

  .es-compare { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem; margin: 1.5rem 0; }
  .es-col { border-radius: 8px; padding: 1.25rem; font-size: .875rem; line-height: 1.6; }
  .es-col--wrong { background: #fef2f2; border: 1px solid #fecaca; }
  .es-col--right { background: #f0fdf4; border: 1px solid #bbf7d0; }
  .es-col h3 { font-size: .85rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; margin-bottom: .6rem; }
  .es-col--wrong h3 { color: #b91c1c; }
  .es-col--right h3 { color: #15803d; }

  .verb-depth-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem; margin: 1.5rem 0; }
  .verb-depth-card { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; box-shadow: var(--shadow); border-top: 3px solid var(--blue); }
  .verb-depth-card--l6 { border-top-color: var(--navy); }
