const whatsappUrl = 'https://wa.me/447916696894';
const siteUrl = 'https://www.cmiassignmenthelp.uk.com';


const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the word count for a CMI Level 6 assignment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Level 6 sets a guideline word count for each unit. In the July 2026 syllabus it is 3,500 words for Units 601, 603, 608 and 614, and 4,000 words for Units 602, 604, 605, 606, 607, 609, 610, 611, 612 and 613. Each has a 10% allowance above or below. The word count on your assignment brief takes precedence over any general guidance."
      }
    },
    {
      "@type": "Question",
      "name": "What does Critically mean in CMI Level 6 criteria?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CMI defines the critical verbs in the syllabus. Critically appraise means a systematic process to identify the strengths and weaknesses of information and judge its usefulness and validity. Critically assess means a reasoned argument based on judgements, considering the validity of the sources used. Critically examine means a thorough examination of assumptions, logic and implications. Critically reflect means questioning deeply held beliefs and assumptions about your own practice. Of the 75 criteria in Units 601 to 614, 29 begin with Critically, and Critically evaluate appears only once."
      }
    },
    {
      "@type": "Question",
      "name": "How many sources are needed for a CMI Level 6 assignment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Level 6 unit specifications don't set a minimum number or type of source. The syllabus says learner work should be accurate, current and authentic, and that critical verbs require you to consider the validity of the sources you use. Your centre's brief and referencing guidance apply. Use credible, current sources, including academic research where it supports your argument, and reference them consistently."
      }
    },
    {
      "@type": "Question",
      "name": "Which CMI Level 6 units are available?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CMI lists 14 units at Level 6, numbered 601 to 614, from 601 Professional Management and Leadership Practice to 614 Principles and Practices of Ethical Decision Making. The units you study depend on the Award, Certificate or Diploma you are taking and your training provider's rules of combination."
      }
    },
    {
      "@type": "Question",
      "name": "Should I study CMI Level 6 or Level 7?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Level 6 is Professional Management and Leadership Practice and Level 7 is Strategic Management and Leadership Practice, each with its own units (601 to 614 and 701 to 716). CMI says Level 6 learners can progress to the CMI Level 7 qualifications. Which is right depends on your role, your employer's expectations and the units your centre offers. If you are unsure, message us on WhatsApp and we will help you check the unit list."
      }
    }
  ]
};

