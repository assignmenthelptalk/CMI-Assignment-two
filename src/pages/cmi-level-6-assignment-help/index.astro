---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import UnitList from '../../components/UnitList.astro';

const whatsappUrl = 'https://wa.me/447916696894';
const siteUrl = 'https://www.cmiassignmenthelp.uk.com';


const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the word count for a CMI Level 6 assignment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CMI Level 6 assignment word counts are set by each unit's assessment brief, but the standard range is 4,000–5,000 words per unit. This is substantially longer than Level 5 (3,000–4,000 words) and reflects the greater analytical depth required by the Critically Evaluate command verb. The word count applies to the main body of the advanced management paper. The executive summary, reference list, and appendices are excluded. Always check your specific unit brief as your training provider may set a different range within the CMI guidelines."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between Evaluate (Level 5) and Critically Evaluate (Level 6)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Evaluate (Level 5) requires the student to apply named management frameworks to a management situation, assess the outcomes or impact, and reach a reasoned conclusion. Critically Evaluate (Level 6) requires all of that, plus: examining the assumptions and limitations of the frameworks used in the specific context; considering at least one alternative framework or counter-argument; and reaching a conclusion that is explicitly justified against the alternatives considered. The word 'critically' signals that the student must not simply apply theories. They must interrogate them. A Level 5 response that applies Kotter and reaches a conclusion would be a Merit at Level 5 but a Pass or lower at Level 6, because it does not critically examine the theoretical basis of the framework."
      }
    },
    {
      "@type": "Question",
      "name": "Do CMI Level 6 assignments require peer-reviewed journals?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Peer-reviewed academic journals are required at CMI Level 6. They are not optional. ManagementDirect (CMI's research library) remains an important source at Level 6, but it is not sufficient on its own. The source requirement at Level 6 is 12–15 Harvard-referenced sources, and this mix should include peer-reviewed journals from management, leadership, or business research databases. Including journal sources demonstrates that the student can engage with academic literature at the level appropriate to professional management, distinguishing Level 6 from Level 5 in both source standard and analytical depth."
      }
    },
    {
      "@type": "Question",
      "name": "Which CMI Level 6 units are available?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CMI lists 14 units at Level 6, numbered 601 to 614, from 601 Professional Management and Leadership Practice to 614 Principles and Practices of Ethical Decision Making. The units you study depend on the Award, Certificate or Diploma you are taking and your training provider's rules of combination."
      }
    },
    {
      "@type": "Question",
      "name": "Should I study CMI Level 6 or Level 7?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CMI Level 6 is the right choice for experienced senior managers, department heads, and those at NHS Band 8+ who are not yet at director or C-suite level. CMI Level 7 is appropriate for directors, C-suite executives, and NHS senior leaders at Executive level. The academic standard difference is significant: Level 6 is equivalent to final-year undergraduate standard, while Level 7 is postgraduate Master's equivalent. Some students study Level 7 directly from Level 5, bypassing Level 6. This is possible but requires a significant jump in analytical standard. If you are unsure which level is right for your role and goals, message us on WhatsApp and we will advise based on your specific situation."
      }
    }
  ]
};

---

<Layout
  title="CMI Level 6 Assignment Help | All 14 Units (601–614)"
  description="CMI Level 6 assignment help for all 14 units (601–614). Critically Evaluate depth, 12–15 sources. UK-based CMI writers, quote in 2 hours."
  canonical={siteUrl + '/cmi-level-6-assignment-help/'}
  pageSchema={faqSchema}
>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">CMI Level 6 — Professional Management and Leadership</p>
      <h1>CMI Level 6 Assignment Help | Professional Management and Leadership</h1>
      <p class="hero-sub">
        Expert assignment help for all 14 CMI Level 6 Professional Management and Leadership units (601–614).
        Critically Evaluate command verb, advanced management paper format, 12–15 Harvard sources including
        peer-reviewed journals. Senior manager and department head student profile. UK-based CMI-qualified writers.
      </p>
      <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
        Get CMI Level 6 Assignment Help
      </a>
      <p class="hero-note">Fixed quote within 2 hours &bull; All 14 units (601–614) &bull; Critically Evaluate standard</p>
    </div>
  </section>

  <img
    class="page-header-img"
    src="/images/headers/cmi-level-6-assignment-help.webp"
    alt="CMI Level 6 Professional Management and Leadership assignment help — senior manager leading a boardroom discussion"
    width="1408"
    height="704"
    loading="eager"
    decoding="async"
  />

  <TableOfContents />

  <!-- What Is CMI Level 6 -->
  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="what-is-cmi-level-6-professional-management-and-leadership">What Is CMI Level 6 Professional Management and Leadership?</h2>
      <p>
        CMI Level 6 in Professional Management and Leadership is the Chartered Management Institute's
        qualification for senior managers, department heads, and directors. It is available as an
        <strong>Award</strong>, <strong>Certificate</strong>, or <strong>Diploma</strong>. The Diploma is
        the most commonly completed pathway and requires a minimum of six units from the 14 available (601–614).
       This level is part of <a href="https://www.cmiassignmenthelp.uk.com/">CMI Assignment Help UK</a>, which covers every CMI qualification from Level 3 to Level 7.</p>
      <p>
        The Level 6 qualification sits at <strong>RQF Level 6</strong>, equivalent to final-year undergraduate
        academic standard. This makes it the critical progression step between CMI Level 5 (operational
        middle management, second-year undergraduate equivalent) and <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-7-assignment-help/">CMI
        Level 7</a> (strategic management and leadership, postgraduate Master's equivalent).
      </p>
      <p>
        The defining characteristic of Level 6 is the introduction of <strong>Critically Evaluate</strong>
        as the primary command verb. Where Level 5 requires students to Evaluate management frameworks in
        their workplace context, Level 6 requires students to critically examine the assumptions and
        limitations of those frameworks and to justify their conclusions against alternative theoretical
        positions. Peer-reviewed academic journals are required at Level 6, not optional.
      </p>
      <p>
        A CMI Level 6 Diploma is a degree-level management qualification, which with 3 years' management experience
        meets CMI's criteria for <strong>MCMI (Member)</strong> membership, awarded by CMI on application. Some students progress directly from Level 5 to Level 7
        without completing Level 6. Whether Level 6 is the right step depends on role level and employer expectations.
      </p>
      <div class="qual-grid">
        <div class="qual-block">
          <h3>Student Profile</h3>
          <p>Senior managers, department heads, NHS Band 8+, experienced commercial directors, and public sector senior leaders in their first senior leadership role.</p>
        </div>
        <div class="qual-block">
          <h3>Academic Standard</h3>
          <p>RQF Level 6, final-year undergraduate equivalent. Bridges Level 5 operational management and Level 7 strategic management with Critically Evaluate as the primary standard.</p>
        </div>
        <div class="qual-block">
          <h3>Membership Outcome</h3>
          <p>MCMI (Member of CMI) is supported by a degree-level qualification plus 3 years' management experience; it sits above Associate (ACMI) and below Fellow (FCMI).</p>
        </div>
        <div class="qual-block">
          <h3>Units Available</h3>
          <p>14 units in total (601–614). The Diploma typically requires 6 units. Your training provider sets which units make up your pathway.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- All 14 Units -->
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title" id="all-14-cmi-level-6-units">All 14 CMI Level 6 Units — Assignment Help by Unit</h2>
      <p class="section-lead">
        Assignment help is available for every CMI Level 6 unit. Send your unit number and brief via WhatsApp
        to receive a quote and be matched with a Level 6 qualified senior manager writer.
      </p>
      <UnitList level={6} />
    </div>
  </section>

  <!-- Format -->
  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="cmi-level-6-assignment-format">CMI Level 6 Assignment Format — Advanced Management Paper</h2>
      <p>
        CMI Level 6 assignments are submitted as advanced management papers, an extension of the
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-5-assignment-help/">Level 5</a> management report with significantly greater
        analytical depth. The format retains the professional structure of the management report but raises
        the academic standard at every section.
      </p>
      <h3 class="sub-h3">Key Differences from the Level 5 Management Report</h3>
      <div class="diff-list">
        <div class="diff-item">
          <span class="diff-label">Command Verb</span>
          <p>Level 5 uses Evaluate as the primary command verb. Level 6 uses Critically Evaluate, requiring examination of theoretical assumptions and explicit consideration of alternative positions, not merely application of a framework.</p>
        </div>
        <div class="diff-item">
          <span class="diff-label">Source Standard</span>
          <p>Level 5 requires 10–12 Harvard-referenced sources, predominantly ManagementDirect. Level 6 requires 12–15 sources <em>including peer-reviewed academic journals</em>. ManagementDirect alone is insufficient at Level 6.</p>
        </div>
        <div class="diff-item">
          <span class="diff-label">Word Count</span>
          <p>Level 5 management reports are typically 3,000–4,000 words. Level 6 advanced management papers are 4,000–5,000 words per unit, reflecting the additional analytical depth required by Critically Evaluate.</p>
        </div>
        <div class="diff-item">
          <span class="diff-label">Analytical Depth</span>
          <p>At Level 5, analysis sections apply frameworks to the workplace context and evaluate outcomes. At Level 6, analysis sections must critically examine the theoretical frameworks themselves: their underlying assumptions, their limitations in the specific context, and how competing frameworks compare.</p>
        </div>
        <div class="diff-item">
          <span class="diff-label">Recommendations</span>
          <p>SMART recommendations remain at Level 6, but must be explicitly justified with reference to the critical evaluation conducted, not derived from a single framework but from the comparative analysis of multiple theoretical positions.</p>
        </div>
      </div>
      <h3 class="sub-h3">Advanced Management Paper Sections</h3>
      <p class="section-list">
        Executive Summary &rarr; Introduction &rarr; Critical Analysis Sections &rarr; Strategic Recommendations
        &rarr; Conclusion &rarr; Bibliography (12–15 sources) &rarr; Appendices
      </p>
      <p class="link-note">
        See the <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-assignment-structure/">CMI assignment structure guide</a> for full
        section-by-section guidance. For help with the management paper format specifically, see
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-report-writing-help/">CMI report writing help</a>.
      </p>
    </div>
  </section>

  <!-- Command Verbs -->
  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="command-verbs-at-cmi-level-6">Command Verbs at CMI Level 6 — Critically Evaluate</h2>
      <p>
        <strong>Critically Evaluate</strong> is the primary command verb at CMI Level 6. It is the most
        common cause of under-performance at this level, because the step from Level 5 Evaluate to
        Level 6 Critically Evaluate is not merely a matter of writing more, but of writing at a different
        analytical register.
      </p>
      <div class="verb-def">
        <h3>Critically Evaluate — Precise Definition</h3>
        <p>Critically Evaluate requires the student to:</p>
        <ol class="verb-steps">
          <li><strong>Apply</strong> named theoretical frameworks to evaluate the subject in context</li>
          <li><strong>Examine the assumptions and limitations</strong> of those frameworks in the specific organisational or management context</li>
          <li><strong>Consider alternative frameworks or counter-arguments</strong>: at least one competing position must be engaged with</li>
          <li><strong>Reach a justified conclusion</strong> that is defensible against the alternatives considered, explaining why the conclusion holds even when the limitations and competing positions are accounted for</li>
        </ol>
      </div>
      <h3 class="sub-h3">Worked Example — Evaluating a Change Initiative</h3>
      <div class="example-grid">
        <div class="example-card example-l5">
          <p class="example-label">Level 5 Evaluate Response</p>
          <p>Applies Kotter's 8-Step Model to a recent change initiative in the student's organisation.
          Evaluates the impact, identifying what worked, what was less effective, and why. Reaches a
          conclusion on the effectiveness of the change programme. Cites ManagementDirect and 10 sources.
          This is Merit standard at Level 5.</p>
        </div>
        <div class="example-card example-l6">
          <p class="example-label">Level 6 Critically Evaluate Response</p>
          <p>Applies Kotter's 8-Step Model and evaluates the same change initiative. Then introduces
          Lewin's Force Field Analysis as a competing change management framework, examines the
          assumptions embedded in both (Kotter assumes linear sequential stages; Lewin assumes
          equilibrium disruption), and identifies the limitations of each in complex, multi-site
          change environments. Justifies why Force Field Analysis better explains the resistance
          dynamics encountered, while acknowledging Kotter's strengths in communication planning.
          Reaches a conclusion on change management effectiveness that accounts for both positions.
          Cites 13 sources including at least two peer-reviewed change management journals.</p>
        </div>
      </div>
      <p class="verb-note">
        Also appearing at Level 6: <strong>Critically Assess</strong> (similar depth, directed at evaluating
        a specific claim or position) and <strong>Assess</strong> (evaluate the significance or value of
        something, at Level 6 depth). For the full command verb hierarchy, see
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-command-verbs-explained/">CMI command verbs explained</a>.
      </p>
    </div>
  </section>

  <!-- Pass Merit Distinction -->
  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="what-a-distinction-looks-like-at-cmi-level-6">What a Distinction Looks Like at CMI Level 6</h2>
      <p>Using an assignment on senior leadership as a worked example:</p>
      <div class="grade-grid">
        <div class="grade-card">
          <h3>Merit</h3>
          <p>Critically Evaluates using named leadership frameworks (at minimum, transformational and
          transactional leadership). Identifies some limitations of the primary framework in the
          student's organisational context. Reaches a reasoned conclusion. Cites 12+ sources including
          at least two peer-reviewed journals. The evaluation demonstrates understanding that frameworks
          have contextual limits but does not yet engage with the academic debate around those limits.</p>
        </div>
        <div class="grade-card grade-distinction">
          <h3>Distinction</h3>
          <p>Critically Evaluates using a minimum of two competing leadership frameworks, for example,
          transformational leadership (Bass and Avolio) versus distributed leadership. Explicitly names
          the assumptions and limitations of transformational approaches in high-accountability sectors
          (the evidence base for transformational leadership is predominantly drawn from manufacturing
          and military contexts; its applicability to regulated professional services environments is
          contested). Draws on peer-reviewed academic leadership research, not just ManagementDirect,
          to support the critical evaluation. Justifies the conclusion by explaining why the competing
          alternative (e.g., Spillane's distributed leadership model, 2005) is more contextually
          appropriate, and why this conclusion holds even if the transformational leadership evidence
          base is accepted. The writing occupies both sides of the argument before reaching a defensible
          position.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Positioning -->
  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="cmi-level-6-vs-level-5-and-level-7">CMI Level 6 vs Level 5 and Level 7 — Where Level 6 Sits</h2>
      <div class="position-grid">
        <div class="position-card">
          <h3>Level 6 vs Level 5</h3>
          <ul>
            <li>Critically Evaluate (L6) vs Evaluate (L5): the 'critically' is a distinct analytical standard, not just more evaluation</li>
            <li>Peer-reviewed academic journals required at L6; ManagementDirect-led at L5</li>
            <li>Word count: 4,000–5,000 at L6 vs 3,000–4,000 at L5</li>
            <li>RQF standard: final-year undergraduate (L6) vs second-year undergraduate (L5)</li>
          </ul>
          <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-5-assignment-help/" class="position-link">CMI Level 5 assignment help &rarr;</a>
        </div>
        <div class="position-card">
          <h3>Level 6 vs Level 7</h3>
          <ul>
            <li>Level 6: Professional Management; Level 7: Strategic Management, different scope and academic register</li>
            <li>Critically Evaluate (L6) vs Critically Analyse (L7): Level 7 requires academic debate engagement and original strategic synthesis</li>
            <li>15–20 peer-reviewed sources at L7 vs 12–15 at L6</li>
            <li>Level 7 is postgraduate Master's equivalent; Level 6 is final-year undergraduate</li>
          </ul>
          <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-7-assignment-help/" class="position-link">CMI Level 7 assignment help &rarr;</a>
        </div>
      </div>
      <p class="position-note">
        <strong>Who should study Level 6?</strong> Senior managers and department heads who are not yet at
        director or C-suite level. Level 7 is appropriate for directors, C-suite executives, and NHS senior
        leaders at Executive level. For a detailed side-by-side comparison, see the
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-level-5-vs-level-7/">CMI Level 5 vs Level 7 guide</a>.
      </p>
    </div>
  </section>

  <!-- How to Order -->
  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="how-to-get-cmi-level-6-assignment-help">How to Get CMI Level 6 Assignment Help</h2>
      <ol class="order-steps">
        <li>Message us on WhatsApp with your unit number (e.g., Unit 602 or Unit 603), your assignment
        brief, and your deadline.</li>
        <li>Receive a fixed quote within 2 hours. No hidden fees.</li>
        <li>A CMI Level 6 qualified senior manager writer produces your submission-ready advanced management
        paper with 12–15 sources including peer-reviewed journals, at Critically Evaluate standard.</li>
      </ol>
      <div class="cta-wrap">
        <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
          Order on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="cmi-level-6-assignment-help-faq">CMI Level 6 Assignment Help — Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-q">What is the word count for a CMI Level 6 assignment?</summary>
          <div class="faq-a">
            <p>CMI Level 6 assignment word counts are set by each unit's assessment brief, but the standard
            range is 4,000–5,000 words per unit. This is substantially longer than Level 5 (3,000–4,000 words)
            and reflects the greater analytical depth required by Critically Evaluate. The word count applies
            to the main body of the advanced management paper. The executive summary, reference list, and
            appendices are excluded. Always check your specific unit brief as your training provider may set
            a different range within CMI guidelines.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">What is the difference between Evaluate (Level 5) and Critically Evaluate (Level 6)?</summary>
          <div class="faq-a">
            <p>Evaluate (Level 5) requires the student to apply named management frameworks, assess the
            outcomes or impact, and reach a reasoned conclusion. Critically Evaluate (Level 6) requires
            all of that plus: examining the assumptions and limitations of the frameworks in the specific
            context; considering at least one alternative framework or counter-argument; and reaching a
            justified conclusion that accounts for the alternatives. The word 'critically' signals that
            the student must interrogate theories, not merely apply them. A Level 5 response that applies
            Kotter and reaches a conclusion is Merit at Level 5, but Pass or lower at Level 6, because
            it does not critically examine the theoretical basis of the framework used.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Do CMI Level 6 assignments require peer-reviewed journals?</summary>
          <div class="faq-a">
            <p>Yes. Peer-reviewed academic journals are required at CMI Level 6. They are not optional.
            ManagementDirect remains an important source but is insufficient on its own at Level 6. The
            source requirement is 12–15 Harvard-referenced sources, and this mix must include peer-reviewed
            journal articles from management, leadership, or business research. Including journal sources
            demonstrates that the student can engage with academic literature at the standard appropriate
            to professional management, which is what distinguishes Level 6 from Level 5 in both source
            standard and analytical depth.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Which CMI Level 6 units are available?</summary>
          <div class="faq-a">
            <p>CMI lists 14 units at Level 6, numbered 601 to 614, from 601 Professional Management and Leadership
            Practice to 614 Principles and Practices of Ethical Decision Making. Which ones you study depends on
            whether you are taking the Award, Certificate or Diploma and on your training provider's rules of
            combination.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Should I study CMI Level 6 or Level 7?</summary>
          <div class="faq-a">
            <p>CMI Level 6 is the right choice for experienced senior managers, department heads, and NHS
            Band 8+ leaders who are not yet at director or C-suite level. CMI Level 7 is appropriate for
            directors, C-suite executives, and NHS senior leaders at Executive level. The academic standard
            difference is significant: Level 6 is final-year undergraduate equivalent, while Level 7 is
            postgraduate Master's equivalent. Some students progress directly from Level 5 to Level 7,
            bypassing Level 6. This is possible but requires a significant jump in analytical standard.
            If you are unsure which is right for your role, WhatsApp us and we will advise.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Supplementary -->
  <section class="section">
    <div class="container">
      <h2 class="section-title" id="related-cmi-assignment-help">Related CMI Assignment Help</h2>
      <div class="supp-grid">
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-assignment-writing-service/" class="supp-card">
          <h3>CMI Assignment Writing Service</h3>
          <p>Full writing support for all CMI levels including Level 6: advanced management paper format, Critically Evaluate standard, 12–15 peer-reviewed sources.</p>
        </a>
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-5-assignment-help/" class="supp-card">
          <h3>CMI Level 5 Assignment Help</h3>
          <p>If you are considering whether to study Level 5 or 6, Level 5 guidance for middle managers and operational leaders at Evaluate standard.</p>
        </a>
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-7-assignment-help/" class="supp-card">
          <h3>CMI Level 7 Assignment Help</h3>
          <p>The next progression from Level 6, Strategic Management and Leadership at postgraduate Master's equivalent depth for directors and C-suite leaders.</p>
        </a>
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-command-verbs-explained/" class="supp-card">
          <h3>CMI Command Verbs Explained</h3>
          <p>Full guide to the command verb hierarchy across all CMI levels, Critically Evaluate at Level 6 depth explained with worked examples.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="cta-section">
    <div class="container cta-inner">
      <h2>Get CMI Level 6 Assignment Help Today</h2>
      <p>WhatsApp us your unit number and deadline. Fixed quote in 2 hours. UK-based CMI Level 6 qualified senior manager writers delivering Critically Evaluate standard.</p>
      <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
        WhatsApp Us Your Level 6 Brief
      </a>
    </div>
  </section>

</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--navy) 0%, var(--blue) 100%);
    color: #fff; padding: 5rem 0 4rem; text-align: center;
  }
  .hero-inner { max-width: 800px; margin: 0 auto; }
  .eyebrow { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #93c5fd; margin-bottom: .75rem; }
  .hero h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 800; color: #fff; margin-bottom: 1.25rem; line-height: 1.2; }
  .hero-sub { font-size: 1.05rem; color: #bfdbfe; margin-bottom: 2rem; line-height: 1.7; }
  .hero-note { font-size: .82rem; color: #93c5fd; margin-top: .75rem; }
  .narrow { max-width: 860px; }

  .qual-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .qual-block { background: var(--bg-light); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; }
  .qual-block h3 { font-size: .9rem; font-weight: 700; color: var(--navy); margin-bottom: .4rem; }
  .qual-block p { font-size: .875rem; color: var(--text-muted); line-height: 1.55; margin: 0; }

  .units-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
  .unit-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; position: relative; }
  .unit-popular { border-top: 3px solid var(--blue); }
