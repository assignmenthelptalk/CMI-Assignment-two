---
import Layout from '../layouts/Layout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import UnitFinder from '../components/UnitFinder.astro';


const whatsappUrl = 'https://wa.me/447916696894';
const siteUrl = 'https://www.cmiassignmenthelp.uk.com';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What does the CMI assignment writing service include?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A complete, submission-ready assignment written to the correct command verb depth for your unit and level. This includes the required CMI format (management report or structured essay), Harvard referencing with sources chosen to support each assessment criterion (the unit specifications don't set a minimum number of sources), and precise alignment to the Learning Outcomes and Assessment Criteria of your specific unit. All documents are written by UK-based CMI-qualified practitioners."
      }
    },
    {
      "@type": "Question",
      "name": "Which CMI levels and units do you cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "All five CMI qualification levels: Level 3 Principles of Management and Leadership (Units 301–321), Level 4 Management and Leadership (Units 4001–4009), Level 5 Management and Leadership Diploma (Units 501–526), Level 6 Professional Management and Leadership (Units 601–614), and Level 7 Strategic Management and Leadership (Units 701–716). That covers all 80+ CMI units across every Award, Certificate, and Diploma pathway."
      }
    },
    {
      "@type": "Question",
      "name": "How do I place an order for CMI assignment help?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Message us on WhatsApp with your unit number, qualification level, assignment brief, and deadline. We respond with a fixed quote within 2 hours and assign a CMI-qualified writer matched to your level and unit subject."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between the writing service and CMI assignment tutoring?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The writing service produces a complete, submission-ready document written by a CMI-qualified practitioner on your behalf. CMI assignment tutoring retains your authorship. The tutor guides you through structure, command verb application, Learning Outcome alignment, and argument construction so that you produce the document. Tutoring is also the primary route for resubmission coaching after a Referral grade."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if my CMI assignment receives a Referral?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Referral means the assignment did not meet one or more Learning Outcomes at the required command verb depth. Our resubmission support identifies which Learning Outcomes were unmet, reads the assessor feedback, and either rewrites the relevant sections (writing service) or guides you through the restructure (tutoring). The most common resubmission causes are insufficient command verb depth (for example, describing where the brief demanded Evaluate) and under-referenced analysis sections."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide CMI assignment help for NHS managers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. NHS managers study CMI qualifications at several levels, and the right level depends on the scope of your role rather than your pay band. Support covers NHS workforce context and leadership frameworks."
      }
    }
  ]
};

const levels = [
  {
    label: 'CMI Level 3',
    title: 'Principles of Management and Leadership',
    slug: 'https://www.cmiassignmenthelp.uk.com/cmi-level-3-assignment-help/',
    units: 'Units 301–321',
    format: '2,000–2,500 words guideline',
    verbs: 'Explain, Identify, Outline',
    profile: 'Team leaders and supervisors',
    badge: null,
  },
  {
    label: 'CMI Level 4',
    title: 'Management and Leadership',
    slug: 'https://www.cmiassignmenthelp.uk.com/cmi-level-4-assignment-help/',
    units: 'Units 4001–4009',
    format: '3,000 words guideline',
    verbs: 'Describe, Discuss, Identify',
    profile: 'Junior and department managers',
    badge: null,
  },
  {
    label: 'CMI Level 5',
    title: 'Management & Leadership Diploma',
    slug: 'https://www.cmiassignmenthelp.uk.com/cmi-level-5-assignment-help/',
    units: 'Units 501–526',
    format: '3,000–5,000 words guideline',
    verbs: 'Analyse, Examine, Evaluate',
    profile: 'Managers accountable to a senior manager',
    badge: null,
  },
  {
    label: 'CMI Level 6',
    title: 'Professional Management and Leadership',
    slug: 'https://www.cmiassignmenthelp.uk.com/cmi-level-6-assignment-help/',
    units: 'Units 601–614',
    format: '3,000–4,000 words guideline',
    verbs: 'Critically appraise, Critically assess',
    profile: 'Experienced managers',
    badge: null,
  },
  {
    label: 'CMI Level 7',
    title: 'Strategic Management and Leadership',
    slug: 'https://www.cmiassignmenthelp.uk.com/cmi-level-7-assignment-help/',
    units: 'Units 701–716',
    format: '3,500–4,500 words guideline',
    verbs: 'Critically appraise, Discuss, Develop',
    profile: 'Senior managers and directors',
    badge: null,
  },
];

const services = [
  {
    icon: '✍️',
    title: 'CMI Assignment Writing Service',
    desc: 'Submission-ready assignment written to the correct command verb depth and the format your centre sets, with full Harvard referencing.',
  },
  {
    icon: '🎓',
    title: 'CMI Assignment Tutoring',
    desc: 'Expert guidance for students who write their own assignment. Covers structure planning, command verb application, Learning Outcome alignment, and resubmission coaching after a Referral.',
  },
  {
    icon: '📋',
    title: 'CMI Coursework Help',
    desc: 'Sustained support across multiple units throughout a full CMI Diploma. Consistent academic framing and command verb depth maintained across the entire qualification.',
  },
  {
    icon: '🔄',
    title: 'CMI Resubmission Support',
    desc: 'Referral recovery: identifying unmet Learning Outcomes from assessor feedback, restructuring the response, and meeting the required command verb depth for the resubmission.',
  },
];

const steps = [
  { n: '01', text: 'Message us on WhatsApp with your unit number, level, and deadline.' },
  { n: '02', text: 'Receive a fixed quote within 2 hours, no hidden fees.' },
  { n: '03', text: 'We match you with a CMI-qualified UK writer at your exact level.' },
  { n: '04', text: 'Receive your submission-ready CMI assignment before your deadline.' },
];
---

<Layout
  title="CMI Assignment Help UK | All Levels 3 to 7"
  description="Expert CMI assignment help for working professionals at Levels 3 to 7. UK-based CMI-qualified writers, all 80+ units covered. WhatsApp order in minutes."
  canonical={siteUrl + '/'}
  pageSchema={faqSchema}
  hideShareSidebar
>

  <!-- ═══════════════════════════════════════════════
       HERO — macro context, WhatsApp CTA above fold
  ══════════════════════════════════════════════════ -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="hero-eyebrow">UK-Based CMI Writers — All Levels 3 to 7</p>
        <h1 class="hero-h1">CMI Assignment Help UK</h1>
        <p class="hero-sub">
          Expert CMI assignment writing, tutoring, and resubmission support for working
          professionals across all 80+ CMI units. Every document written to the correct
          command verb depth, so each criterion can be met.
        </p>
        <UnitFinder />
        <div class="hero-ctas">
          <a
            href={whatsappUrl}
            class="btn btn-whatsapp hero-wa"
            target="_blank"
            rel="noopener noreferrer"
          >
            Get a WhatsApp Quote
          </a>
        </div>
        <p class="hero-note">Fixed quote in 2 hours &bull; All 5 CMI qualification levels &bull; UK-based writers</p>
      </div>
      <picture class="hero-art" aria-hidden="true">
        <source media="(min-width: 1024px)" srcset="/images/hero/hero-selector-wide.webp" type="image/webp" width="1376" height="768" />
        <img
          src="/images/hero/hero-selector-square.webp"
          alt=""
          aria-hidden="true"
          width="1024"
          height="1024"
          decoding="async"
          fetchpriority="low"
        />
      </picture>
    </div>
  </section>

  <TableOfContents />

  <!-- ═══════════════════════════════════════════════
       LEVEL NAVIGATION — qualification framework
  ══════════════════════════════════════════════════ -->
  <section class="section" id="levels">
    <div class="container">
      <h2 class="section-title" id="cmi-assignment-help-by-level">CMI Assignment Help by Level</h2>
      <p class="section-lead">
        Select your CMI qualification level for level-specific assignment writing, tutoring, and unit-by-unit support.
        Every level has distinct command verb requirements, format standards, and word count targets. Our writers are
        matched to your exact level.
      </p>
      <div class="level-grid">
        {levels.map(lvl => (
          <div class="level-card">
            {lvl.badge && <span class="level-badge">{lvl.badge}</span>}
            <h3 class="level-title"><a href={lvl.slug} class="card-link">{lvl.label} assignment help</a></h3>
            <p class="level-qual">{lvl.title}</p>
            <ul class="level-meta">
              <li><span class="meta-key">Units:</span> {lvl.units}</li>
              <li><span class="meta-key">Format:</span> {lvl.format}</li>
              <li><span class="meta-key">Command verbs:</span> {lvl.verbs}</li>
              <li><span class="meta-key">Student profile:</span> {lvl.profile}</li>
            </ul>
            <span class="level-link" aria-hidden="true">View {lvl.label} units →</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SERVICES — service type disambiguation
  ══════════════════════════════════════════════════ -->
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title" id="cmi-assignment-support-services">CMI Assignment Support Services</h2>
      <p class="section-lead">
        Four distinct service types to match the support you need, whether you require a complete written assignment,
        expert guidance on your own draft, or structured help across a full CMI Diploma. Everything is delivered
        remotely: see how <a href="https://www.cmiassignmenthelp.uk.com/cmi-assignment-help-online/">CMI assignment help online</a> works, with
        every service option in one place.
      </p>
      <div class="services-grid">
        {services.map(svc => (
          <div class="service-card service-card-static">
            <span class="svc-icon" aria-hidden="true">{svc.icon}</span>
            <h3 class="svc-title">{svc.title}</h3>
            <p class="svc-desc">{svc.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       HOW IT WORKS — WhatsApp process
  ══════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <h2 class="section-title" id="how-cmi-assignment-help-works">How CMI Assignment Help Works</h2>
      <p class="section-lead">
        The entire process runs through WhatsApp, from initial quote to final delivery. No registration, no portals.
      </p>
      <div class="steps-grid">
        {steps.map(step => (
          <div class="step-card">
            <span class="step-num" aria-hidden="true">{step.n}</span>
            <p class="step-text">{step.text}</p>
          </div>
        ))}
      </div>
      <div class="steps-cta">
        <a
          href={whatsappUrl}
          class="btn btn-whatsapp btn-lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          Start on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       WRITER CREDIBILITY — trust signals
  ══════════════════════════════════════════════════ -->
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title" id="uk-based-cmi-qualified-writers">UK-Based CMI-Qualified Writers</h2>
      <p class="section-lead">
        Every CMI assignment is written by a practitioner who holds the CMI qualification at the level they write,
        not a generalist academic writer.
      </p>
      <div class="cred-grid">
        <div class="cred-card">
          <h3 class="cred-title">Qualification Match</h3>
          <p>
            Writers hold current CMI qualifications at the level they are assigned. A Level 7 strategic paper is
            written by a CMI Level 7 holder, not by a Level 5 practitioner writing upward.
          </p>
        </div>
        <div class="cred-card">
          <h3 class="cred-title">Command Verb Expertise</h3>
          <p>
            Every response is calibrated to the exact command verb in your brief. Critically appraise at Level 7
            requires different argumentation depth, source weight, and structural positioning than Evaluate at Level 5.
            Our writers know the difference and write to assessor expectations.
          </p>
        </div>
        <div class="cred-card">
          <h3 class="cred-title">UK Sector Experience</h3>
          <p>
            Writers are UK-based management practitioners, NHS leaders, public sector managers, commercial directors,
            and professional services leaders. CMI qualification content is grounded in UK management context;
            our writers reflect that.
          </p>
        </div>
        <div class="cred-card">
          <h3 class="cred-title">Harvard Referencing to CMI Standards</h3>
          <p>
            All assignments use Harvard referencing with credible sources chosen to support each criterion,
            including CMI's ManagementDirect where it is relevant. The unit specifications don't set a minimum number of sources, so your centre's brief and referencing guidance apply.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       FAQ — contextual border (macro → supplementary)
  ══════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container faq-wrap">
      <h2 class="section-title" id="cmi-assignment-help-faq">CMI Assignment Help — Frequently Asked Questions</h2>
      <div class="faq-list">

        <details class="faq-item">
          <summary class="faq-q">What does the CMI assignment writing service include?</summary>
          <div class="faq-a">
            <p>
              A complete, submission-ready assignment written to the correct command verb depth for your unit and level.
              This includes the required CMI format (management report or structured essay), Harvard referencing with sources chosen to support each assessment criterion (the unit specifications don't set a minimum number of sources), and precise
              alignment to the Learning Outcomes and Assessment Criteria of your specific unit. All documents are written
              by UK-based CMI-qualified practitioners.
            </p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">Which CMI levels and units do you cover?</summary>
          <div class="faq-a">
            <p>
              All five CMI qualification levels: Level 3 Principles of Management and Leadership
              (Units 301–321), Level 4 Management and Leadership (Units 4001–4009),
              Level 5 Management and Leadership Diploma (Units 501–526),
              Level 6 Professional Management and Leadership (Units 601–614),
              and Level 7 Strategic Management and Leadership (Units 701–716).
              That covers all 80+ CMI units across every Award, Certificate, and Diploma pathway.
            </p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">How do I place an order for CMI assignment help?</summary>
          <div class="faq-a">
            <p>
              Message us on WhatsApp with your unit number, qualification level, assignment brief, and deadline.
              We respond with a fixed quote within 2 hours and assign a CMI-qualified writer matched to your level
              and unit subject. See the CMI assignment help online page for full
              process details.
            </p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">What is the difference between the writing service and CMI assignment tutoring?</summary>
          <div class="faq-a">
            <p>
              The writing service produces a complete, submission-ready
              document written by a CMI-qualified practitioner on your behalf. CMI
              assignment tutoring retains your authorship. The tutor guides you through structure, command verb
              application, Learning Outcome alignment, and argument construction so that you produce the document.
              Tutoring is also the primary route for resubmission coaching after a Referral grade.
            </p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">What happens if my CMI assignment receives a Referral?</summary>
          <div class="faq-a">
            <p>
              A Referral means the assignment did not meet one or more Learning Outcomes at the required command verb
              depth. Our resubmission support identifies which Learning Outcomes were unmet, reads the assessor
              feedback, and either rewrites the relevant sections (writing service) or guides you through the
              restructure (tutoring). The most common causes of CMI referrals are insufficient command verb depth
              (for example, describing where the brief demanded Evaluate) and under-referenced analysis sections.
            </p>
            <p>Message us on WhatsApp with your original submission and assessor feedback for resubmission support.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">Do you provide CMI assignment help for NHS managers?</summary>
          <div class="faq-a">
            <p>
              Yes. NHS managers study CMI qualifications at several levels, and the right level depends on the scope
              of your role rather than your pay band. Support covers NHS workforce context and leadership
              frameworks. See our <a href="https://www.cmiassignmenthelp.uk.com/guides/nhs-management-cmi-qualifications/">guide to CMI qualifications for NHS managers</a>.
            </p>
          </div>
        </details>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       FINAL CTA
  ══════════════════════════════════════════════════ -->
  <section class="section cta-section">
    <div class="container cta-inner">
      <h2 class="cta-h2">Get Your CMI Assignment Help Today</h2>
      <p class="cta-sub">
        Message us on WhatsApp with your unit number and deadline. Fixed quote in 2 hours.
        UK-based CMI-qualified writers across all levels and all 80+ CMI units.
      </p>
      <a
        href={whatsappUrl}
        class="btn btn-whatsapp btn-lg"
        target="_blank"
        rel="noopener noreferrer"
      >
        WhatsApp Us for a Quote
      </a>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ── */
  .hero {
    background: var(--hero-bg);
    color: var(--navy);
    padding: 5rem 0 4rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
  }
  .hero-text {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  /* Decorative illustration. Multiply lets its near-white background take on the hero tint. */
  .hero-art {
    display: block;
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
  }
  .hero-art img {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(closest-side at 50% 50%, #000 78%, transparent 100%);
    mask-image: radial-gradient(closest-side at 50% 50%, #000 78%, transparent 100%);
  }
  .hero-eyebrow {
    font-size: .85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--blue);
    margin-bottom: .75rem;
  }
  .hero-h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: var(--navy);
  }
  .hero-sub {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text);
    max-width: 600px;
    margin: 0 auto 2rem;
  }
  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 1rem;
  }
  /* WhatsApp is the secondary action here: outline in WhatsApp green, dark text. */
  .hero-wa {
    background: transparent;
    color: var(--navy);
    border: 2px solid var(--green);
    padding: .6rem 1.5rem;
  }
  .hero-wa:hover {
    background: var(--green);
    color: var(--navy);
  }
  .btn-lg { padding: .85rem 2rem; font-size: 1.05rem; }
  .btn-outline {
    background: transparent;
    color: var(--blue);
    border: 2px solid var(--accent);
  }
  .btn-outline:hover {
    background: var(--hero-tint);
    border-color: var(--accent-strong-hover);
    color: var(--accent-strong-hover);
    text-decoration: none;
    transform: translateY(-1px); --text-muted: var(--text);
  }
  .hero-note {
    font-size: .82rem;
    color: var(--blue);
  }
  @media (min-width: 1024px) {
    /* Same centred column as on phones, with the wide illustration below the selector.
       Its left third is empty, so crop it with CSS to centre the artwork. */
    .hero-art { max-width: 520px; }
    .hero-art img {
      aspect-ratio: 10 / 9;
      object-fit: cover;
      object-position: 100% 50%;
      -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 50%, transparent 100%);
      mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 50%, transparent 100%);
    }
  }

  /* ── Level cards ── */
  .level-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 1.25rem;
  }
  .level-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #fff;
    box-shadow: var(--shadow);
    color: var(--text);
    text-decoration: none;
    transition: border-color .15s, box-shadow .15s, transform .1s;
    position: relative;
  }
  .level-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
    text-decoration: none;
    color: var(--text);
  }
  .level-badge {
    position: absolute;
    top: -1px;
    right: 1rem;
    background: var(--blue);
    color: #fff;
    font-size: .7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    padding: .2rem .6rem;
    border-radius: 0 0 6px 6px;
  }
  .level-label {
    font-size: .78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--blue);
    margin-bottom: .35rem;
  }
  .level-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .level-meta {
    list-style: none;
    font-size: .82rem;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: .3rem;
    flex: 1;
    margin-bottom: 1rem;
  }
  .meta-key {
    font-weight: 600;
    color: var(--text);
  }
  .level-link {
    font-size: .82rem;
    font-weight: 600;
    color: var(--blue-light);
    margin-top: auto;
  }

  .level-qual { font-size: .85rem; color: var(--text-muted); margin: -.6rem 0 1rem; line-height: 1.35; }
  .level-title { margin-bottom: 1rem; }
  .level-unit-note { margin-top: 1.5rem; font-size: .95rem; color: var(--text-muted); }

  /* Whole card stays clickable, but the anchor text is only the card title */
  .level-card, .service-card { position: relative; }
  .card-link { color: inherit; text-decoration: none; }
  .card-link::after { content: ''; position: absolute; inset: 0; }
  .card-link:focus-visible { outline: none; }
  .card-link:focus-visible::after { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 10px; }

  /* ── Services grid ── */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .service-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow);
    text-decoration: none;
    color: var(--text);
    transition: border-color .15s, box-shadow .15s, transform .1s;
  }
  .service-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
    text-decoration: none;
    color: var(--text);
  }
  .service-card-static:hover { border-color: var(--border); box-shadow: var(--shadow); transform: none; }
  .svc-icon { font-size: 2rem; margin-bottom: .75rem; }
  .svc-title {
    font-size: 1.05rem;
