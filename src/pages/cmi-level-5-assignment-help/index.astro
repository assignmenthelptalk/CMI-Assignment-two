const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the word count for a CMI Level 5 management report?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CMI Level 5 management reports are typically 3,000–5,000 words per unit. This word count covers the full management report structure: executive summary (150–200 words, not included in the main word count at most centres), introduction, main analysis sections, recommendations, and conclusion. The reference list and appendices are also excluded from the word count at most centres. The word count specified in your unit brief from your awarding centre is definitive and takes precedence over any general guidance."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between Evaluate and Critically Evaluate at Level 5?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Evaluate requires the student to make a reasoned judgement by weighing evidence against named theoretical frameworks, identifying strengths and weaknesses, and reaching a conclusion. The conclusion is mandatory. An evaluation without a clear position does not meet the verb requirement. Critically Evaluate goes further: in addition to the evaluation, the student must examine the limitations and assumptions of the frameworks used, consider counter-arguments or alternative interpretations, and demonstrate that their conclusion has been tested against challenge. Critically Evaluate is the primary verb at CMI Level 6 and a Merit-to-Distinction differentiator at Level 5. A student who Evaluates where Critically Evaluate is demanded will typically receive a Pass or Referral, not a Distinction."
      }
    },
    {
      "@type": "Question",
      "name": "Which CMI Level 5 units are available?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CMI lists 26 units at Level 5, numbered 501 to 526, from 501 Principles of Management and Leadership in an Organisational Context to 526 Principles of Leadership Practice. The units you study depend on the Award, Certificate or Diploma you are taking and your training provider's rules of combination."
      }
    },
    {
      "@type": "Question",
      "name": "How many Harvard sources are needed for a CMI Level 5 assignment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The minimum Harvard referencing requirement for a CMI Level 5 management report is 10–12 sources. Merit and Distinction responses typically cite 12 or more sources with deliberate diversity: CMI ManagementDirect is a required primary source at Level 5; academic texts (Tuckman, Herzberg, Kotter, Lewin) provide theoretical grounding; peer-reviewed journal articles demonstrate research engagement; and government or sector publications add contextual authority for units such as Unit 506 (Managing Equality, Diversity and Inclusion) or Unit 518 (Risk Management). All sources must appear in the text as in-text citations and in a complete reference list formatted to Harvard standard."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between CMI Level 5 and Level 7?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CMI Level 5 (Management and Leadership Diploma) and CMI Level 7 (Strategic Management and Leadership) differ across four dimensions: student profile, command verb depth, source requirements, and format scope. Level 5 is designed for middle managers and carries Evaluate and Justify as its primary verbs, requiring 10–12 Harvard sources per unit and producing 3,000–5,000 word management reports. Level 7 is designed for directors, C-suite executives, and senior NHS leaders (Band 8+), and carries Critically Analyse and Justify as primary verbs, requiring 15–20 sources per unit and producing 5,000–8,000 word strategic papers. ACMI membership is open on completion of a Level 5 Diploma; MCMI and FCMI depend on management experience. See the full CMI Level 5 vs Level 7 comparison guide for a unit-by-unit analysis of the differences."
      }
    },
    {
      "@type": "Question",
      "name": "Do you help with a specific CMI Level 5 unit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We cover all 26 Level 5 units, from 501 to 526. Each unit needs Evaluate and Justify depth, a management report structure and SMART recommendations derived from the evaluation. Message us on WhatsApp with your unit number, brief and deadline for a fixed quote."
      }
    }
  ]
};
