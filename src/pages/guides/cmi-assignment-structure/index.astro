---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/TableOfContents.astro';

const whatsappUrl = 'https://wa.me/447916696894';
const siteUrl = 'https://www.cmiassignmenthelp.uk.com';


const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "CMI Assignment Structure Guide — Reports, Accounts and Reflective Writing",
  "description": "How to structure a CMI assignment: what CMI's syllabuses say about formats, and practical advice on structuring reports, scenario responses and reflective accounts so every criterion is answered.",
  "author": { "@type": "Organization", "name": "CMI Assignment Help UK" },
  "publisher": { "@type": "Organization", "name": "CMI Assignment Help UK", "url": siteUrl }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Does CMI require a management report or an essay?", "acceptedAnswer": { "@type": "Answer", "text": "CMI does not fix one format for every unit. The syllabus sets the assessment criteria, and your centre sets the task. CMI's recommendations for each unit suggest ways to assess, most often a written report, a response to a scenario, an account, or a reflective account. Follow the format and instructions in your own assignment brief." } },
    { "@type": "Question", "name": "Do I need an executive summary?", "acceptedAnswer": { "@type": "Answer", "text": "CMI does not require one. If your brief or centre template asks for a report with an executive summary, write it last and make it report what you found and recommend, not introduce the topic. If your brief does not ask for one, follow the brief." } },
    { "@type": "Question", "name": "Do CMI recommendations need to be SMART?", "acceptedAnswer": { "@type": "Answer", "text": "CMI does not require SMART recommendations. CMI defines Recommend as putting forward proposals, alternatives or suggestions supported by a clear rationale appropriate to the situation. SMART (specific, measurable, achievable, relevant, time-bound) is a widely used way to make recommendations concrete, and it helps you show the rationale, so it is useful where your brief asks for actions." } },
    { "@type": "Question", "name": "How should I split my word count?", "acceptedAnswer": { "@type": "Answer", "text": "Start from the guideline word count for your unit, which has a 10% allowance above or below. Give each assessment criterion a share, weight the larger share to criteria that ask you to judge or build something, and keep the introduction and conclusion short so they do not crowd out the criteria." } },
    { "@type": "Question", "name": "Can I use headings in my assignment?", "acceptedAnswer": { "@type": "Answer", "text": "Headings are usually helpful because they show the assessor which criterion each section answers. Check your centre's brief or template for any rules on layout." } }
  ]
};
---

<Layout
  title="CMI Assignment Structure Guide - Format & Layout | CMIAssignmentHelp.uk.com"
  description="How to structure a CMI assignment: what the syllabuses say about formats, and practical advice on reports, scenario responses and reflective accounts."
  canonical={siteUrl + '/guides/cmi-assignment-structure/'}
  pageSchema={[articleSchema, faqSchema]}
>

  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Reports &bull; Scenario Responses &bull; Reflective Accounts</p>
      <h1>CMI Assignment Structure Guide | Reports, Accounts and Reflective Writing</h1>
      <p class="hero-sub">
        CMI sets the assessment criteria and your centre sets the task, so the format comes from your brief.
        This guide shows what CMI's syllabuses say about formats and gives practical advice on structuring a
        report, a response to a scenario and a reflective account so that every criterion is answered. The
        advice is ours. It is not a CMI requirement.
      </p>
      <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
        Need Help with Your CMI Assignment Structure?
      </a>
    </div>
  </section>

  <img
    class="page-header-img"
    src="/images/headers/cmi-assignment-structure.webp"
    alt="CMI assignment structure guide — reports, accounts and reflective writing"
    width="1376"
    height="688"
    loading="eager"
    decoding="async"
  />

  <TableOfContents />

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="which-format-does-your-unit-require">Which Format Does Your Unit Require?</h2>
      <p>
        The assessment requirements are the criteria in each unit. For every unit CMI lists recommended ways to
        assess, which it describes as guidance only, and the learner must meet all of the criteria. The syllabus also
        says written work is expected to form the majority of assessable work, and that group assessment is not
        recognised. Three signals tell you the format: the instructions in your brief, the verbs in the criteria, and
        any template from your centre.
      </p>
      <div class="format-decision-grid">
        <div class="format-decision">
          <h3>Report</h3>
          <p><strong>Suggested for:</strong> every unit at Levels 3, 5, 6 and 7 mention a report among their recommendations.</p>
          <p>Use headings that follow the criteria, and finish with conclusions or recommendations if the criteria ask for them.</p>
        </div>
        <div class="format-decision">
          <h3>Scenario Response or Account</h3>
          <p><strong>Suggested for:</strong> 19 of 21 Level 3 units and 24 of 26 Level 5 units mention a scenario.</p>
          <p>Answer the criteria in order in the context of the scenario, using your own organisation or the one given.</p>
        </div>
        <div class="format-decision">
          <h3>Reflective Account</h3>
          <p><strong>Suggested for:</strong> 18 of 21 Level 3 units, 25 of 26 Level 5, all 14 Level 6 and 15 of 16 Level 7 units.</p>
          <p>First-person academic writing about your own practice. Unit 714 (Level 7) and Unit 525 (Level 5) are built around it.</p>
        </div>
      </div>
      <p>
        Understanding the <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-command-verbs-explained/">CMI command verbs</a> in your criteria
        is the first step. They tell you whether each section must describe, explain, analyse, evaluate or build.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title" id="management-report-9-sections">A Practical Report Structure</h2>
      <p class="section-lead">
        CMI does not set a section list. This layout is a common, sensible way to organise a report, so adapt it to
        your brief or centre template.
      </p>
      <div class="report-sections">
        <div class="report-section"><div class="rs-num">1</div><div class="rs-body"><h3 class="rs-title">Title Page</h3><p class="rs-desc">Assignment title, unit number and name, your name and registration details, submission date and word count, as your centre requires.</p></div></div>
        <div class="report-section report-section--alert"><div class="rs-num">2</div><div class="rs-body"><h3 class="rs-title">Executive Summary <span class="rs-alert">Only if your brief asks</span></h3><p class="rs-desc">A short summary of the findings and recommendations, not an introduction to the topic. Write it last. Covered below.</p></div></div>
        <div class="report-section"><div class="rs-num">3</div><div class="rs-body"><h3 class="rs-title">Contents</h3><p class="rs-desc">Section headings with page numbers, useful for any longer submission.</p></div></div>
        <div class="report-section"><div class="rs-num">4</div><div class="rs-body"><h3 class="rs-title">Introduction</h3><p class="rs-desc">Purpose, scope and the organisational context you are using. Keep it brief so it does not take words from the criteria.</p></div></div>
        <div class="report-section"><div class="rs-num">5</div><div class="rs-body"><h3 class="rs-title">Main Sections, One Per Criterion or Learning Outcome</h3><p class="rs-desc">Headings that mirror the criteria so the assessor can see each one answered. Do what the verb asks, and use theory as a tool for your own situation.</p></div></div>
        <div class="report-section"><div class="rs-num">6</div><div class="rs-body"><h3 class="rs-title">Recommendations or Proposal</h3><p class="rs-desc">Where the criteria use verbs such as Develop, Propose or Recommend, set out what you recommend and the rationale, drawn from your analysis.</p></div></div>
        <div class="report-section"><div class="rs-num">7</div><div class="rs-body"><h3 class="rs-title">Conclusion</h3><p class="rs-desc">Draws the findings together. Avoid new material.</p></div></div>
        <div class="report-section"><div class="rs-num">8</div><div class="rs-body"><h3 class="rs-title">References</h3><p class="rs-desc">Every source cited in the text, in the style your centre requires. See our <a href="https://www.cmiassignmenthelp.uk.com/guides/harvard-referencing-cmi/">Harvard referencing guide</a>.</p></div></div>
        <div class="report-section"><div class="rs-num">9</div><div class="rs-body"><h3 class="rs-title">Appendices</h3><p class="rs-desc">CMI asks learners to keep appendices to a minimum. Evidence that shows a criterion is met belongs in the main body, not only in an appendix, and each appendix should be referred to in the text.</p></div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="executive-summary">The Executive Summary — Findings, Not Introduction</h2>
      <p>
        If your brief asks for an executive summary, write it last. It should tell a reader who sees nothing else what
        the report found and what it recommends. The common mistake is to write an introduction instead.
      </p>
      <div class="es-compare">
        <div class="es-col es-col--wrong">
          <h3>What It Is Not</h3>
          <p>"This report will examine leadership approaches at [organisation] with reference to Kotter's change management framework..." (an introduction sentence describing what the report will do).</p>
        </div>
        <div class="es-col es-col--right">
          <h3>What It Is</h3>
          <p>"Analysis of the leadership approach used during [organisation]'s restructure shows that the directive style delivered the timetable but weakened engagement. Three recommendations follow." (a summary of what the report found).</p>
        </div>
      </div>
      <p>
        Keep it short, and check your brief for any length your centre sets. CMI does not set one.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="analysis-sections">Analysis Sections — Answer the Criterion, Using Theory as a Tool</h2>
      <p>For each criterion or learning outcome, a section that follows this order usually works:</p>
      <ol class="analysis-steps">
        <li><strong>Opening statement</strong>: says which criterion the section answers and what it will cover, without giving away the conclusion.</li>
        <li><strong>Framework or evidence</strong>: introduces the theory, model or source briefly, then applies it directly to your organisation. The theory is the tool and your context is the subject.</li>
        <li><strong>The verb's operation</strong>: the core of the section, at the depth the verb asks, for example weighing strengths and weaknesses and reaching a judgement for Evaluate, or checking the validity of the information for Critically appraise.</li>
        <li><strong>Sub-conclusion</strong>: a sentence or short paragraph stating what you found, which feeds into any recommendations.</li>
      </ol>
      <p>
        Common errors: describing a framework and then describing it again instead of using it; reaching a
        conclusion early and adding material that supports a different one; using a framework for a general
        situation rather than the scenario in the brief.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="smart-recommendations">Recommendations — Making Them Concrete</h2>
      <p>
        CMI defines Recommend as putting forward proposals, alternatives or suggestions supported by a clear
        rationale appropriate to the situation. CMI does not require SMART recommendations, but SMART, from Doran
        (1981), is a common way to make a recommendation concrete, and it makes the rationale easier to show:
      </p>
      <div class="smart-grid">
        <div class="smart-item"><h3>Specific</h3><p>Names a concrete action. "Improve communication" is vague. "Introduce weekly one-to-ones from [date]" is specific.</p></div>
        <div class="smart-item"><h3>Measurable</h3><p>Includes a success measure, for example "90% completion of the training module by [date]".</p></div>
        <div class="smart-item"><h3>Achievable</h3><p>Realistic within the constraints your analysis described.</p></div>
        <div class="smart-item"><h3>Relevant</h3><p>Traceable to a specific finding. A recommendation with no basis in the analysis is unsupported.</p></div>
        <div class="smart-item"><h3>Time-bound</h3><p>Includes a timeline for implementation or review.</p></div>
      </div>
      <p>Only include recommendations where the criteria ask for them. If the verb is Evaluate or Analyse, a judgement or conclusion is what is needed.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="word-count-distribution">Planning Your Word Count</h2>
      <p>
        Every unit has a guideline word count with a 10% allowance above or below, and your brief takes precedence.
        At Level 5 the guidelines range from 3,000 to 5,000 words, at Level 6 they are 3,500 or 4,000, and at Level 7
        they are 3,500, 4,000 or 4,500 for the Group A units.
      </p>
      <ol class="analysis-steps">
        <li><strong>Count the criteria.</strong> List every assessment criterion in your brief or the syllabus.</li>
        <li><strong>Share the guideline.</strong> Divide the usable words between them, giving a larger share to criteria that ask you to judge or build something, such as Evaluate, Critically appraise or Develop, than to criteria that ask you to identify or describe.</li>
        <li><strong>Keep the frame short.</strong> A brief introduction and conclusion leave more words for the criteria, which is where they are met.</li>
        <li><strong>Check the count against the allowance</strong> before you submit.</li>
      </ol>
      <p>
        The two most common word count problems are a long introduction that crowds out the analysis and a
        conclusion that introduces new points instead of drawing the findings together.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="structured-essay-format">Scenario Responses and Accounts</h2>
      <p>
        Many units suggest responding to a scenario or writing an account. These do not need the full report
        apparatus. A clean structure is enough:
      </p>
      <ul class="essay-parts">
        <li><strong>Title</strong>: the question or a direct response to it.</li>
        <li><strong>Introduction</strong>: the topic, the context and how you will address the criteria.</li>
        <li><strong>Body</strong>: one section or group of paragraphs per criterion, each doing what the verb asks. The PEEL pattern (Point, Evidence, Explanation, Link) keeps paragraphs tight.</li>
        <li><strong>Conclusion</strong>: draws the findings together. No new content.</li>
        <li><strong>References</strong>: every source you cite, in your centre's style.</li>
      </ul>
      <p>
        Headings that name each criterion help the assessor see that nothing is missing. Check your centre's brief for
        any rule on layout. For the units, see <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-3-assignment-help/">CMI Level 3 assignment help</a> and
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-4-assignment-help/">CMI Level 4 assignment help</a>.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="reflective-account-structure">Reflective Accounts — Using Gibbs, Kolb or Johns</h2>
      <p>
        Reflective accounts are written in the first person ("I observed", "I concluded") about your own practice. CMI
        defines Critically reflect as identifying, questioning and assessing
        deeply held beliefs and assumptions about your practice. The syllabuses name reflective models as examples, so
        use one that suits you and say why.
      </p>
      <div class="reflective-grid">
        <div class="reflective-model">
          <h3>Gibbs' Reflective Cycle — 6 Stages</h3>
          <ol>
            <li>Description: what happened</li>
            <li>Feelings: what you thought and felt</li>
            <li>Evaluation: what was good or bad</li>
            <li>Analysis: theory applied to make sense of the situation</li>
            <li>Conclusion: what else you could have done</li>
            <li>Action plan: what you will do differently</li>
          </ol>
        </div>
        <div class="reflective-model">
          <h3>Kolb's Experiential Learning Cycle (1984) — 4 Stages</h3>
          <ol>
            <li>Concrete experience: the event or situation</li>
            <li>Reflective observation: reflection on the experience</li>
            <li>Abstract conceptualisation: theory applied to the experience</li>
            <li>Active experimentation: what you will try differently</li>
          </ol>
        </div>
      </div>
      <p>
        Johns' Model of Structured Reflection (1995, 2006) is also named in the Level 7 syllabus. Whichever model you
        use, show how theory and evidence inform your reflection rather than only recounting events. For more, see
        our <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-reflective-practice/">reflective practice guide</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title" id="common-structure-errors">Common Structure Errors</h2>
      <p class="section-lead">These structural problems often lead to criteria that are not yet met.</p>
      <ol class="error-list">
        <li><strong>A criterion that is never answered directly</strong>: the content is relevant but the section does not do what the verb asks.</li>
        <li><strong>Executive summary written as an introduction</strong>, where one is required.</li>
        <li><strong>New content in the conclusion</strong>: it suggests the analysis is incomplete.</li>
        <li><strong>Theory described rather than applied</strong>: the framework is explained at length, not used on your situation.</li>
        <li><strong>Recommendations without an analytical basis</strong>: not traceable to a finding.</li>
        <li><strong>Word count imbalance</strong>: the introduction or conclusion takes words from the criteria.</li>
        <li><strong>Essential evidence left in an appendix</strong>: CMI asks for evidence that shows a criterion is met to be in the main body.</li>
        <li><strong>A reflective account written in the third person</strong>.</li>
        <li><strong>Sources in the list but never cited in the text</strong>, or the reverse.</li>
        <li><strong>Inconsistent referencing</strong>: incomplete or mixed citation styles.</li>
      </ol>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="structure-faq">CMI Assignment Structure — Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item"><summary class="faq-q">Does CMI require a management report or an essay?</summary><div class="faq-a"><p>CMI does not fix one format for every unit. The syllabus sets the assessment criteria, and your centre sets the task. CMI's recommendations for each unit suggest ways to assess, most often a written report, a response to a scenario, an account, or a reflective account. Follow the format and instructions in your own assignment brief.</p></div></details>
        <details class="faq-item"><summary class="faq-q">Do I need an executive summary?</summary><div class="faq-a"><p>CMI does not require one. If your brief or centre template asks for a report with an executive summary, write it last and make it report what you found and recommend, not introduce the topic. If your brief does not ask for one, follow the brief.</p></div></details>
        <details class="faq-item"><summary class="faq-q">Do CMI recommendations need to be SMART?</summary><div class="faq-a"><p>CMI does not require SMART recommendations. CMI defines Recommend as putting forward proposals, alternatives or suggestions supported by a clear rationale appropriate to the situation. SMART is a widely used way to make recommendations concrete, and it helps you show the rationale, so it is useful where your brief asks for actions.</p></div></details>
        <details class="faq-item"><summary class="faq-q">How should I split my word count?</summary><div class="faq-a"><p>Start from the guideline word count for your unit, which has a 10% allowance above or below. Give each assessment criterion a share, weight the larger share to criteria that ask you to judge or build something, and keep the introduction and conclusion short so they do not crowd out the criteria.</p></div></details>
        <details class="faq-item"><summary class="faq-q">Can I use headings in my assignment?</summary><div class="faq-a"><p>Headings are usually helpful because they show the assessor which criterion each section answers. Check your centre's brief or template for any rules on layout.</p></div></details>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Related CMI Assignment Services</h2>
      <div class="supp-grid">
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-report-writing-help/" class="supp-card"><h3>CMI Report Writing Help</h3><p>Specialist support for report-format assignments, structured to your criteria.</p></a>
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-command-verbs-explained/" class="supp-card"><h3>CMI Command Verbs Explained</h3><p>What each section must achieve, from Identify to Critically appraise.</p></a>
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-assignment-tutoring/" class="supp-card"><h3>CMI Assignment Tutoring</h3><p>Structure planning sessions before a single word of the main content is written.</p></a>
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-5-assignment-help/" class="supp-card"><h3>CMI Level 5 Assignment Help</h3><p>All 26 Level 5 units (501 to 526), written to the unit criteria and command verbs.</p></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title">Related CMI Unit Pages</h2>
      <p>Unit-level support for the units most relevant to this guide:</p>
      <ul class="unit-links">
        <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-301-assignment-help/">CMI Unit 301 assignment help</a>: Principles of Management and Leadership (Level 3)</li>
        <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-501-assignment-help/">CMI Unit 501 assignment help</a>: Principles of Management and Leadership in an Organisational Context (Level 5)</li>
        <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-525-assignment-help/">CMI Unit 525 assignment help</a>: Using Reflective Practice to Inform Personal and Professional Development (Level 5)</li>
        <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-714-assignment-help/">CMI Unit 714 assignment help</a>: Personal and Professional Development for Strategic Leaders (Level 7)</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title">Related CMI Guides</h2>
      <p>More guides that connect to this topic:</p>
      <ul class="unit-links">
        <li><a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-command-verbs-explained/">CMI Command Verbs Explained</a></li>
        <li><a href="https://www.cmiassignmenthelp.uk.com/guides/harvard-referencing-cmi/">Harvard Referencing for CMI Assignments</a></li>
        <li><a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-reflective-practice/">CMI Reflective Practice Guide</a></li>
        <li><a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-resubmission-guide/">CMI Assignment Referral and Resubmission Guide</a></li>
      </ul>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-inner">
      <h2>WhatsApp Us Your Brief</h2>
      <p>Not sure which format your unit needs, or want a fully structured submission-ready assignment? Message us with your unit number and level.</p>
      <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
        Get a Fully Structured CMI Assignment
      </a>
    </div>
  </section>

</Layout>

<style>
  .hero { background: var(--hero-bg); color: var(--navy); padding: 5rem 0 4rem; text-align: center; }
  .hero-inner { max-width: 820px; margin: 0 auto; }
  .eyebrow { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--blue); margin-bottom: .75rem; }
  .hero h1 { font-size: clamp(1.6rem, 3.6vw, 2.5rem); font-weight: 800; color: var(--navy); margin-bottom: 1.25rem; line-height: 1.25; }
  .hero-sub { font-size: 1.05rem; color: var(--text); margin-bottom: 2rem; line-height: 1.7; }

  .narrow { max-width: 860px; }

  .format-decision-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.25rem; margin: 1.5rem 0; }
  .format-decision { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem; box-shadow: var(--shadow); }
  .format-decision h3 { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: .5rem; }
  .format-decision p { font-size: .875rem; color: var(--text-muted); line-height: 1.55; margin: 0 0 .4rem; }

  .report-sections { display: flex; flex-direction: column; gap: 1rem; }
  .report-section { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1rem 1.25rem; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .report-section--alert { border-color: var(--accent); background: var(--hero-tint); --text-muted: var(--text); }
  .rs-num { font-size: 1.3rem; font-weight: 800; color: var(--blue); }
  .rs-title { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: .35rem; display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
  .rs-alert { font-size: .68rem; font-weight: 700; text-transform: uppercase; background: var(--green); color: var(--navy); padding: .15rem .5rem; border-radius: 20px; }
  .rs-desc { font-size: .88rem; color: var(--text-muted); line-height: 1.6; margin: 0; }

  .es-compare { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem; margin: 1.5rem 0; }
