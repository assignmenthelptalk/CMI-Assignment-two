---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/TableOfContents.astro';

const whatsappUrl = 'https://wa.me/447916696894';
const siteUrl = 'https://www.cmiassignmenthelp.uk.com';


const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "CMI Level 5 vs Level 7 — Which Is Right for You?",
  "description": "CMI Level 5 vs Level 7 compared using the CMI syllabuses: units, credits, command verbs, word counts, roles each level is written for, and progression to Chartered Manager.",
  "author": { "@type": "Organization", "name": "CMI Assignment Help UK" },
  "publisher": { "@type": "Organization", "name": "CMI Assignment Help UK", "url": siteUrl }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Can I go straight to CMI Level 7 without completing Level 5 first?", "acceptedAnswer": { "@type": "Answer", "text": "CMI does not specify entry requirements for Level 5 or Level 7, and learners must be 19 or over. Centres are required to make sure each learner has sufficient capability at the right level to undertake the learning and assessment, so the decision sits with your centre. Level 7 is written for practising or aspiring senior managers and leaders, so your role and experience matter more than whether you hold a Level 5 qualification." } },
    { "@type": "Question", "name": "Is CMI Level 7 much harder than Level 5?", "acceptedAnswer": { "@type": "Answer", "text": "It asks for something different. Level 5 criteria mostly ask you to analyse, examine and evaluate, and none begins with Critically. At Level 7, 37 of the 80 criteria begin with Critically, most often Critically appraise, and many end with a build task such as a strategy, a proposal or a framework. The scope also moves from leading teams to shaping strategy across the organisation." } },
    { "@type": "Question", "name": "How do the assessment formats and word counts differ between Level 5 and Level 7?", "acceptedAnswer": { "@type": "Answer", "text": "CMI does not fix one format for every unit at either level. Your centre sets the task within CMI's recommendations, which include reports, accounts, presentations and reflective accounts. Each unit has a guideline word count with a 10% allowance above or below. At Level 5 the guidelines range from 3,000 to 5,000 words. At Level 7 they are 3,500, 4,000 or 4,500 words for the 16 Group A units." } },
    { "@type": "Question", "name": "Does CMI Level 5 or Level 7 lead to Chartered Manager?", "acceptedAnswer": { "@type": "Answer", "text": "CMI says learners completing the Level 5 Diploma, the Level 7 Diploma or the Level 7 Extended Diploma may be eligible for Chartered Manager (CMgr) where they have evidence of at least three years of management and leadership experience. All successful Level 5 learners are eligible for Foundation Chartered Manager (fCMgr) on completion, subject to keeping CMI membership. The qualification is one input to those decisions, so check CMI's current pages for the conditions." } },
    { "@type": "Question", "name": "Should I do CMI Level 6 instead of jumping from Level 5 to Level 7?", "acceptedAnswer": { "@type": "Answer", "text": "CMI lists the Level 6 qualifications in Management and Leadership as a progression route from Level 5, and Level 7 as a route from Level 6. Level 6 is Professional Management and Leadership Practice, with units 601 to 614. Which step suits you depends on your role, your employer and the units your centre offers." } }
  ]
};
---

<Layout
  title="CMI Level 5 vs Level 7 - Comparison Guide | CMIAssignmentHelp.uk.com"
  description="CMI Level 5 vs Level 7 compared from the CMI syllabuses: units, credits, command verbs, word counts, who each level is for, and progression to Chartered Manager."
  canonical={siteUrl + '/guides/cmi-level-5-vs-level-7/'}
  pageSchema={[articleSchema, faqSchema]}
>

  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Comparison Guide &bull; Management vs Strategic Management</p>
      <h1>CMI Level 5 vs Level 7 | Which Is Right for You?</h1>
      <p class="hero-sub">
        CMI Level 5 is Management and Leadership. CMI Level 7 is Strategic Management and Leadership Practice.
        This guide compares them using CMI's own syllabuses: the units, the credits, the command verbs, the
        word counts, the roles each is written for and where each leads, so you can see which level fits your role.
      </p>
      <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
        Not Sure Which CMI Level Fits Your Role?
      </a>
    </div>
  </section>

  <img
    class="page-header-img"
    src="/images/headers/cmi-level-5-vs-level-7.webp"
    alt="CMI Level 5 vs Level 7 — which qualification is right for you"
    width="1376"
    height="688"
    loading="eager"
    decoding="async"
  />

  <TableOfContents />

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="at-a-glance">CMI Level 5 vs Level 7 at a Glance</h2>
      <p>
        Level 5 is aimed at managers who lead and manage individuals and teams to deliver objectives in line with
        organisational strategy. Level 7 is aimed at senior managers and leaders, and its units are about setting
        and shaping that strategy. Both are graded Pass or Refer.
      </p>
      <table class="wc-table compare-table">
        <thead>
          <tr><th>Dimension</th><th>CMI Level 5</th><th>CMI Level 7</th></tr>
        </thead>
        <tbody>
          <tr><td>Qualification</td><td>Management and Leadership</td><td>Strategic Management and Leadership Practice</td></tr>
          <tr><td>Units</td><td>501 to 526 (26 units)</td><td>701 to 716 (16 Group A units) plus six Group B units</td></tr>
          <tr><td>Diploma size</td><td>At least 37 credits, six units</td><td>At least 37 credits: 30 from Group A and 7 from Group A or B</td></tr>
          <tr><td>Larger qualification</td><td>Extended Diploma, at least 54 credits</td><td>Extended Diploma, at least 64 credits</td></tr>
          <tr><td>Criteria</td><td>248, mostly Analyse, Examine and Evaluate</td><td>80, 37 of them beginning Critically</td></tr>
          <tr><td>Guideline word count</td><td>3,000 to 5,000 words per unit</td><td>3,500, 4,000 or 4,500 words per Group A unit</td></tr>
          <tr><td>Roles CMI names</td><td>Operations, Divisional, Departmental, Regional and Specialist Manager</td><td>Senior Manager, Regional Manager, Specialist Manager, Director and CEO</td></tr>
          <tr><td>Progression</td><td>fCMgr on completion, CMgr from the Diploma with 3 years' experience, then Level 6</td><td>CMgr from the Diploma or Extended Diploma with 3 years' experience, then Level 8</td></tr>
        </tbody>
      </table>
      <p>
        Neither level is universally "better". The right level depends on your current role, your
        experience and where you are trying to get to, not on which qualification sounds more
        impressive on a CV.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="scope">Scope — Managing Teams vs Shaping Strategy</h2>
      <p>
        CMI describes the primary role at Level 5 as leading and managing individuals and teams to deliver aims
        and objectives in line with organisational strategy. The roles it may include are developing teams and
        individuals, creating operational plans, managing projects and change, managing finance and resources,
        managing quality and continuous improvement, and managing the human resources function. Level 5 learners
        are typically accountable to a senior manager or business owner.
      </p>
      <p>
        Level 7 is written for practising or aspiring managers who need the knowledge, skills and behaviours to
        drive business activities in a senior management and leadership role. Its units cover Strategic Leadership
        (701), Developing Organisational Strategy (704), Leading Strategic Change (705), Finance for Strategic
        Leaders (706), Organisational Design and Development (707) and Strategic Risk Management (708), among others.
      </p>
      <div class="format-decision-grid">
        <div class="format-decision">
          <h3>Level 5 asks:</h3>
          <p>"How do I lead my team and deliver these objectives well?"</p>
        </div>
        <div class="format-decision">
          <h3>Level 7 asks:</h3>
          <p>"How should the organisation set its direction, and how do I lead it there?"</p>
        </div>
      </div>
      <p>
        The assignments draw on workplace evidence, so a role that matches the level makes the work easier to
        write authentically.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="format">Assessment and Word Count at Each Level</h2>
      <p>
        CMI sets the criteria and your centre sets the task. At both levels the syllabus says written work is
        expected to form the majority of assessable work, every criterion has to be met, and group assessment is
        not a recognised method. CMI does not fix a single document type for every unit: its recommendations
        include reports, accounts, presentations, scenario responses, plans and reflective accounts, and they vary
        from unit to unit.
      </p>
      <table class="wc-table compare-table">
        <thead>
          <tr><th>Element</th><th>Level 5</th><th>Level 7</th></tr>
        </thead>
        <tbody>
          <tr><td>Format</td><td>Set by your centre within CMI's recommendations</td><td>Set by your centre within CMI's recommendations</td></tr>
          <tr><td>Guideline length</td><td>3,000 to 5,000 words per unit, plus or minus 10%</td><td>3,500 to 4,500 words per Group A unit, plus or minus 10%</td></tr>
          <tr><td>Sources</td><td>No minimum number set</td><td>No minimum number set</td></tr>
          <tr><td>Grading</td><td>Pass or Refer</td><td>Pass or Refer</td></tr>
        </tbody>
      </table>
      <p>
        On sources, CMI asks for appropriate use of evidence, examples and references to support conclusions and
        recommendations, and says critical verbs require you to consider the validity of the sources you use.
        Your centre's brief and referencing guidance apply at both levels.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="command-verb-depth">Command Verbs — Analyse, Examine and Evaluate vs Critically Appraise</h2>
      <p>
        Level 5 has 248 assessment criteria in Units 501 to 526. Analyse (66), Examine (51) and Evaluate (48) are the
        most common verbs, followed by Assess (22), Discuss (21), Develop (10) and Recommend (10). None begins with
        Critically.
      </p>
      <p>
        Level 7 has 80 criteria in Units 701 to 716, and 37 of them begin with Critically. Critically appraise (18)
        and Critically assess (7) lead, and Discuss (9), Develop (8), Propose (5) and Recommend (5) are the other common
        verbs. No Level 7 criterion uses Critically analyse.
      </p>
      <div class="es-compare">
        <div class="es-col es-col--wrong">
          <h3>Level 5 — Evaluate</h3>
          <p>Consider strengths and weaknesses and arguments for and against, judge the evidence, and make a valid conclusion or reasoned judgement.</p>
        </div>
        <div class="es-col es-col--right">
          <h3>Level 7 — Critically appraise</h3>
          <p>Use a systematic process to identify the strengths and weaknesses of information in order to assess its usefulness and validity.</p>
        </div>
      </div>
      <p>
        Those are CMI's definitions. The practical change is that at Level 7 you are expected to question the
        material itself, including the validity of your sources, and many criteria then ask you to propose or
        recommend something. Always follow the verb on your own criteria. Our
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-command-verbs-explained/">command verbs guide</a> covers each in detail.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="student-profile">Who Studies Each Level</h2>
      <p>
        CMI designed Level 5 for practising or aspiring managers in roles such as Operations Manager, Divisional
        Manager, Departmental Manager, Regional Manager and Specialist Manager, typically accountable to a senior
        manager or business owner. Many learners are newly promoted or preparing for that step.
      </p>
      <p>
        CMI designed Level 7 for practising or aspiring managers in roles such as Senior Manager, Regional Manager,
        Specialist Manager, Director and CEO. At Level 7 CMI describes a Specialist Manager as someone with expertise in a
        function such as quality, finance, risk, marketing, IT or human resources.
      </p>
      <p>
        A useful self-check: if your work would mostly describe leading a team to deliver objectives, Level 5 is
        likely the right starting point. If it would describe shaping direction, strategy or organisation-wide
        change, Level 7 is closer. Your centre makes the final call on whether you have the capability for a level.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="career-membership">Progression — Foundation Chartered Manager, Chartered Manager and Beyond</h2>
      <table class="wc-table compare-table">
        <thead>
          <tr><th>Level</th><th>What CMI says on completion</th></tr>
        </thead>
        <tbody>
          <tr><td>Level 5</td><td>All successful learners are eligible for Foundation Chartered Manager (fCMgr), subject to keeping CMI membership. Diploma learners may be eligible for Chartered Manager (CMgr) with at least three years of management and leadership experience. Level 6 is a progression route.</td></tr>
          <tr><td>Level 7</td><td>Diploma and Extended Diploma learners may be eligible for Chartered Manager (CMgr) with at least three years of management and leadership experience. CMI Level 8 qualifications in Strategic Direction and Leadership are a further progression route.</td></tr>
        </tbody>
      </table>
      <p>
        These are eligibility statements, not guarantees, so check CMI's current pages for the conditions. CMI
        membership grades such as ACMI, MCMI and FCMI are a separate question from the qualification itself; see our
        guide to
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-membership-levels-acmi-mcmi-fcmi/">MCMI, FCMI and ACMI membership grades</a>
        for what each requires.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="which-level">Which Level Should You Choose?</h2>
      <div class="decision-grid">
        <div class="decision-card">
          <h3>Choose Level 5 if:</h3>
          <ul>
            <li>Your role is leading and managing individuals and teams to deliver objectives.</li>
            <li>Your work would draw on operational plans, projects, change, resources and quality.</li>
            <li>You want a route to fCMgr, and to CMgr with the Diploma and three years' experience.</li>
            <li>Your centre confirms you have the capability for the level.</li>
          </ul>
        </div>
        <div class="decision-card">
          <h3>Choose Level 7 if:</h3>
          <ul>
            <li>Your current or imminent role is senior manager, director or similar.</li>
            <li>Your work would draw on strategy, organisational design, risk, finance and change at senior level.</li>
            <li>You are ready for criteria that ask you to appraise critically and then propose or recommend.</li>
            <li>You want a route to CMgr, and on to Level 8 later.</li>
          </ul>
        </div>
      </div>
      <p>
        If you sit between the two, <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-6-assignment-help/">CMI Level 6 assignment help</a>
        covers Professional Management and Leadership Practice (units 601 to 614), which CMI lists as a progression
        route from Level 5 towards Level 7.
      </p>
      <p>
        Whichever level fits, the assignment support is written to the unit criteria.
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-5-assignment-help/">CMI Level 5 assignment help</a> covers units 501 to 526 and
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-7-assignment-help/">CMI Level 7 assignment help</a> covers units 701 to 716.
      </p>
      <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
        Tell Us Your Level and Unit — We'll Confirm the Right Support
      </a>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="level-5-vs-7-faq">CMI Level 5 vs Level 7 — Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item"><summary class="faq-q">Can I go straight to CMI Level 7 without completing Level 5 first?</summary><div class="faq-a"><p>CMI does not specify entry requirements for Level 5 or Level 7, and learners must be 19 or over. Centres must make sure each learner has sufficient capability at the right level, so the decision sits with your centre. Level 7 is written for practising or aspiring senior managers and leaders, so your role and experience matter more than whether you hold a Level 5 qualification.</p></div></details>
        <details class="faq-item"><summary class="faq-q">Is CMI Level 7 much harder than Level 5?</summary><div class="faq-a"><p>It asks for something different. Level 5 criteria mostly ask you to analyse, examine and evaluate, and none begins with Critically. At Level 7, 37 of the 80 criteria begin with Critically, most often Critically appraise, and many end with a build task such as a strategy, a proposal or a framework. The scope also moves from leading teams to shaping strategy across the organisation.</p></div></details>
        <details class="faq-item"><summary class="faq-q">How do the assessment formats and word counts differ between Level 5 and Level 7?</summary><div class="faq-a"><p>CMI does not fix one format for every unit at either level. Your centre sets the task within CMI's recommendations, which include reports, accounts, presentations and reflective accounts. Each unit has a guideline word count with a 10% allowance above or below. At Level 5 the guidelines range from 3,000 to 5,000 words. At Level 7 they are 3,500, 4,000 or 4,500 words for the 16 Group A units.</p></div></details>
        <details class="faq-item"><summary class="faq-q">Does CMI Level 5 or Level 7 lead to Chartered Manager?</summary><div class="faq-a"><p>CMI says learners completing the Level 5 Diploma, the Level 7 Diploma or the Level 7 Extended Diploma may be eligible for Chartered Manager (CMgr) where they have evidence of at least three years of management and leadership experience. All successful Level 5 learners are eligible for Foundation Chartered Manager (fCMgr) on completion, subject to keeping CMI membership. Check CMI's current pages for the conditions.</p></div></details>
        <details class="faq-item"><summary class="faq-q">Should I do CMI Level 6 instead of jumping from Level 5 to Level 7?</summary><div class="faq-a"><p>CMI lists the Level 6 qualifications in Management and Leadership as a progression route from Level 5, and Level 7 as a route from Level 6. Level 6 is Professional Management and Leadership Practice, with units 601 to 614. Which step suits you depends on your role, your employer and the units your centre offers.</p></div></details>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Related CMI Assignment Services</h2>
      <div class="supp-grid">
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-5-assignment-help/" class="supp-card"><h3>CMI Level 5 Assignment Help</h3><p>All 26 units (501 to 526), written to the unit criteria and command verbs.</p></a>
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-7-assignment-help/" class="supp-card"><h3>CMI Level 7 Assignment Help</h3><p>All 16 Group A units (701 to 716), written to the unit criteria and command verbs.</p></a>
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-6-assignment-help/" class="supp-card"><h3>CMI Level 6 Assignment Help</h3><p>Professional Management and Leadership Practice, units 601 to 614.</p></a>
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-command-verbs-explained/" class="supp-card"><h3>CMI Command Verbs Explained</h3><p>The command verb hierarchy across CMI levels, with CMI definitions.</p></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title">Related CMI Unit Pages</h2>
      <p>Unit-level support for the units most relevant to this guide:</p>
      <ul class="unit-links">
        <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-501-assignment-help/">CMI Unit 501 assignment help</a>: Principles of Management and Leadership in an Organisational Context (Level 5)</li>
        <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-502-assignment-help/">CMI Unit 502 assignment help</a>: Principles of Developing, Managing and Leading Individuals and Teams to Achieve Success (Level 5)</li>
        <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-714-assignment-help/">CMI Unit 714 assignment help</a>: Personal and Professional Development for Strategic Leaders (Level 7)</li>
        <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-704-assignment-help/">CMI Unit 704 assignment help</a>: Developing Organisational Strategy (Level 7)</li>
        <li><a href="https://www.cmiassignmenthelp.uk.com/cmi-701-assignment-help/">CMI Unit 701 assignment help</a>: Strategic Leadership (Level 7)</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title">Related CMI Guides</h2>
      <p>More guides that connect to this topic:</p>
      <ul class="unit-links">
        <li><a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-qualification-levels-explained/">CMI Qualification Levels Explained</a></li>
        <li><a href="https://www.cmiassignmenthelp.uk.com/guides/is-cmi-qualification-worth-it/">Is a CMI Qualification Worth It?</a></li>
        <li><a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-membership-levels-acmi-mcmi-fcmi/">CMI Membership: ACMI, MCMI and FCMI</a></li>
        <li><a href="https://www.cmiassignmenthelp.uk.com/guides/nhs-management-cmi-qualifications/">CMI Qualifications for NHS Managers</a></li>
      </ul>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-inner">
      <h2>WhatsApp Us About Level 5 or Level 7</h2>
      <p>Tell us your current role, your unit, and the level you're studying. We'll confirm the right support tier and command verb depth for your assignment.</p>
      <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
        WhatsApp Us Now
      </a>
    </div>
  </section>

</Layout>

<style>
  .hero { background: var(--hero-bg); color: var(--navy); padding: 5rem 0 4rem; text-align: center; }
  .hero-inner { max-width: 820px; margin: 0 auto; }
  .eyebrow { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--blue); margin-bottom: .75rem; }
  .hero h1 { font-size: clamp(1.6rem, 3.6vw, 2.5rem); font-weight: 800; color: var(--navy); margin-bottom: 1.25rem; line-height: 1.25; }
  .hero-sub { font-size: 1.05rem; color: var(--text); margin-bottom: 2rem; line-height: 1.7; }

  .narrow { max-width: 860px; }

  .wc-table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: .9rem; }
  .wc-table td, .wc-table th { padding: .75rem 1rem; border: 1px solid var(--border); text-align: left; }
  .wc-table th { background: var(--navy); color: #fff; font-weight: 600; }
  .wc-table tr:nth-child(even) { background: var(--bg-light); --text-muted: var(--text); }
  .wc-table td:first-child { font-weight: 600; color: var(--navy); }
  .compare-table th:nth-child(2), .compare-table th:nth-child(3) { color: #fff; }

  .format-decision-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.25rem; margin: 1.5rem 0; }
  .format-decision { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem; box-shadow: var(--shadow); }
  .format-decision h3 { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: .5rem; }
  .format-decision p { font-size: .875rem; color: var(--text-muted); line-height: 1.55; margin: 0; }

  .es-compare { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem; margin: 1.5rem 0; }
  .es-col { border-radius: 8px; padding: 1.25rem; font-size: .875rem; line-height: 1.6; }
  .es-col--wrong { background: #fef2f2; border: 1px solid #fecaca; --text-muted: var(--text); }
  .es-col--right { background: #f0fdf4; border: 1px solid #bbf7d0; --text-muted: var(--text); }
  .es-col h3 { font-size: .85rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; margin-bottom: .6rem; }
  .es-col--wrong h3 { color: #b91c1c; }
  .es-col--right h3 { color: #15803d; }

  .decision-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; margin: 1.5rem 0; }
  .decision-card { background: var(--bg-light); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; --text-muted: var(--text); }
  .decision-card h3 { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: .75rem; }
  .decision-card ul { padding-left: 1.25rem; display: flex; flex-direction: column; gap: .5rem; }
  .decision-card li { font-size: .9rem; color: var(--text-muted); line-height: 1.55; }

  .btn-lg { padding: .85rem 1.75rem; font-size: 1rem; margin-top: 1.5rem; }

  .faq-list { display: flex; flex-direction: column; gap: .75rem; margin-top: 1.5rem; }
  .faq-item { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  .faq-q { display: block; padding: 1.1rem 1.25rem; font-weight: 600; font-size: .975rem; color: var(--navy); cursor: pointer; list-style: none; background: var(--bg-light); --text-muted: var(--text); }
