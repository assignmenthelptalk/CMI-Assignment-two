---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';

const whatsappUrl = 'https://wa.me/447916696894';
const siteUrl = 'https://cmiassignmenthelp.uk.com';


const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "CMI Assignment Tutoring",
  "description": "One-to-one CMI assignment tutoring for students who want to write their own assignment with expert guidance. Command verb coaching, structure planning, Learning Outcome alignment, and resubmission support across all levels 3 to 7.",
  "provider": {
    "@type": "Organization",
    "name": "CMI Assignment Help UK",
    "url": siteUrl
  },
  "areaServed": "United Kingdom",
  "serviceType": "Academic Tutoring",
  "url": siteUrl + "/cmi-assignment-tutoring/"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the difference between CMI assignment tutoring and your writing service?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CMI assignment tutoring is expert coaching where the student writes the assignment. The tutor provides professional direction on command verb requirements, management report structure, framework selection, and Learning Outcome alignment. The student retains authorship of the final submission. The CMI assignment writing service produces the complete submission-ready document on the student's behalf. Both services are available for all levels 3 to 7. Some students use tutoring for units they want to attempt independently and the writing service for units where the submission deadline or assessment complexity makes full delivery more practical."
      }
    },
    {
      "@type": "Question",
      "name": "Can you tutor me after I have received a CMI Referral?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Post-Referral resubmission tutoring is available for all levels and all units. Send the original submission, the assessor feedback document, and the unit brief via WhatsApp. The tutoring process covers reading the feedback to identify what was unmet, mapping it to the specific command verb or structural gap indicated, building a resubmission plan, and reviewing the revised draft before resubmission. A fixed quote is provided within two hours."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a CMI tutoring session take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tutoring sessions are priced by unit and complexity, not by time. Written tutoring guidance on a submitted draft is typically delivered within 48 to 72 hours depending on the assignment length and the complexity of the Learning Outcomes. Live WhatsApp sessions are agreed at a time convenient to the student and typically run 30 to 60 minutes depending on the scope of what needs to be covered. Turnaround and format are confirmed at quote stage."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer tutoring for all CMI levels including Level 7?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Tutoring is available for all levels from 3 to 7 and all Diploma units within each level. Level 7 tutoring addresses Critically Analyse at strategic scope, primary academic source selection, and the register shift from Level 6 to Level 7 that is the most common calibration challenge at this level. Level 7 sessions are typically longer and more complex than Level 5 sessions, which is reflected in the fixed quote."
      }
    },
    {
      "@type": "Question",
      "name": "Can you review my draft CMI assignment and tell me if I will pass?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Draft review is a core component of the tutoring service. Send the draft, the unit brief, and the level via WhatsApp. The review assesses the draft against the unit's Learning Outcomes and the command verb requirements at the relevant grade band, identifies where the response falls short of Pass, Merit, or Distinction standard, and specifies what must be changed or added. The review does not guarantee an outcome, as the training provider's assessor makes the final decision, but it confirms whether the response meets the assessment standard as understood from the Grade Descriptors and Learning Outcome criteria."
      }
    }
  ]
};
---

<Layout
  title="CMI Assignment Tutoring | Expert Guidance Across All Levels 3 to 7"
  description="CMI assignment tutoring for working professionals who want to write their own assignment with expert guidance. Command verb coaching, structure planning, Learning Outcome alignment, and resubmission support. All levels 3–7. UK-based CMI tutors."
  canonical={siteUrl + '/cmi-assignment-tutoring/'}
  pageSchema={[serviceSchema, faqSchema]}
>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">UK-Based CMI Tutors — Student Retains Authorship</p>
      <h1>CMI Assignment Tutoring | Expert Guidance Across All Levels</h1>
      <p class="hero-sub">
        One-to-one coaching for working professionals who want to write their own CMI assignment with
        expert direction on command verb application, management report structure, Learning Outcome
        alignment, and academic argumentation. You write the assignment. We ensure it meets the CMI
        assessment standard before you submit it. All levels 3 to 7, all Diploma units.
      </p>
      <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
        Book a CMI Tutoring Session
      </a>
      <p class="hero-note">Fixed quote within 2 hours &bull; All levels 3–7 &bull; Post-Referral tutoring available</p>
    </div>
  </section>

  <img
    class="page-header-img"
    src="/images/headers/cmi-assignment-tutoring.webp"
    alt="CMI assignment tutoring — one-to-one expert guidance"
    width="1376"
    height="688"
    loading="eager"
    decoding="async"
  />

  <TableOfContents />

  <!-- S2 -->
  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="what-is-cmi-assignment-tutoring">What Is CMI Assignment Tutoring — and How Is It Different from a Writing Service?</h2>
      <p>
        CMI assignment tutoring is expert one-to-one coaching where the student produces the final
        assignment document. The tutor provides professional direction on what the assessment requires,
        how to structure the response, what command verb depth to apply, and whether a draft meets the
        standard before submission. The student writes. The tutor ensures the response will be assessed
        correctly.
      </p>
      <p>
        This is distinct from the <a href="/cmi-assignment-writing-service/">CMI assignment writing service</a>,
        where a CMI-qualified writer produces the complete submission-ready document on the student's behalf.
        Both services address the same core problem (the gap between what a working professional knows
        about their subject and what a CMI assessment requires them to demonstrate academically) for
        different students at different points in the submission process.
      </p>
      <p>Tutoring is appropriate when:</p>
      <ul>
        <li>The student wants to write their own assignment but is uncertain whether their planned approach meets the command verb requirement</li>
        <li>The student is partway through a draft and wants a review before completing it</li>
        <li>The student has received a Referral decision and needs to understand which Learning Outcomes were unmet before rewriting</li>
        <li>The student wants to understand the assessment expectations for a unit before attempting it, so they can calibrate their approach from the start</li>
      </ul>
      <p>
        The two services are not mutually exclusive. Students working through a full Diploma often use
        tutoring for units they want to attempt independently and the writing service for units where the
        deadline or complexity makes full delivery the more practical option.
      </p>
    </div>
  </section>

  <!-- S3 -->
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title" id="who-needs-cmi-assignment-tutoring">Who Needs CMI Assignment Tutoring?</h2>
      <p class="section-lead">Four student profiles account for the majority of CMI tutoring requests across all levels.</p>
      <div class="profile-grid">
        <div class="profile-card">
          <h3>The Capable Manager Who Struggles with Academic Language</h3>
          <p>
            Understands their subject thoroughly and produces well-reasoned management decisions every
            day. The challenge is bridging professional expertise into the specific academic format,
            cognitive operation, and evidential standard CMI assessment requires, not adding knowledge.
          </p>
        </div>
        <div class="profile-card profile-card--urgent">
          <h3>The Post-Referral Student <span class="profile-badge">Highest Urgency</span></h3>
          <p>
            Has already completed the work and received assessor feedback identifying which Learning
            Outcomes were not met. Needs a precise understanding of what was unmet before rewriting.
            Without it, the rewrite repeats the same error.
          </p>
        </div>
        <div class="profile-card">
          <h3>The Mid-Draft Student</h3>
          <p>
            60–70% through writing an assignment, with a formed response, but uncertain whether the
            command verb has been met at the required depth. A mid-point review is more efficient than
            a full rewrite after submission.
          </p>
        </div>
        <div class="profile-card">
          <h3>The Strategic Diploma Student</h3>
          <p>
            Working through a full CMI Diploma and wants to understand each unit's assessment standard
            before writing, rather than discovering gaps at submission or in Referral feedback.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- S4 -->
  <section class="section">
    <div class="container">
      <h2 class="section-title" id="what-a-cmi-tutoring-session-covers">What a CMI Tutoring Session Covers</h2>
      <p class="section-lead">
        A session is structured around the student's specific unit brief and current draft, if one exists.
        Sessions can be synchronous (a WhatsApp call or written Q&amp;A) or asynchronous (written guidance
        on a submitted draft).
      </p>
      <ul class="includes-list">
        <li>
          <strong>Assignment brief analysis</strong>: unpacking the command verbs in the brief, mapping
          each question to the Learning Outcome it addresses, and identifying what the assessor will be
          looking for at the relevant grade band.
        </li>
        <li>
          <strong>Structure planning</strong>: confirming whether the required format is a management
          report, essay, or reflective account, which sections are needed, and the word count distribution
          across sections.
        </li>
        <li>
          <strong>Command verb coaching</strong>: a precise, level-specific definition of what the command
          verb in the brief demands, with a worked example drawn from the student's own assignment question.
          The most frequently requested tutoring component.
        </li>
        <li>
          <strong>Theory and framework selection</strong>: which management theories are appropriate for the
          unit's Learning Outcomes, and how to apply them as an analytical tool rather than describing them.
        </li>
        <li>
          <strong>Draft review</strong>: assessing a partial or complete draft against the Learning Outcomes
          and command verb requirements, identifying where the response falls short of Merit or Distinction
          standard.
        </li>
      </ul>
    </div>
  </section>

  <!-- S5 -->
  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="command-verb-coaching">Command Verb Coaching — The Most Common Tutoring Request</h2>
      <p>
        The gap between what a verb means in professional practice and what it means at CMI assessment
        standard is the primary cause of Referrals across all levels. Command verb coaching is the most
        frequently requested tutoring component at every qualification level. See the full
        <a href="/guides/cmi-command-verbs-explained/">CMI command verbs explained</a> guide for every verb
        across all five levels.
      </p>
      <div class="verb-mini-grid">
        <div class="verb-mini"><h3>Analyse — Level 4</h3><p>Break the subject into components, apply a named framework as the analytical lens, examine how components interact, and derive a conclusion. Description is not analysis.</p></div>
        <div class="verb-mini"><h3>Evaluate — Level 5</h3><p>Apply a named framework, identify strengths and limitations in context, and reach a justified conclusion. An Evaluate response that does not reach a conclusion is incomplete.</p></div>
        <div class="verb-mini"><h3>Critically Evaluate — Level 6</h3><p>Adds a further requirement: examine the assumptions and limitations of the framework itself, consider alternative frameworks, and show the conclusion has been tested against counter-arguments.</p></div>
        <div class="verb-mini"><h3>Critically Analyse — Level 7</h3><p>Operates at strategic scope. Engage with the academic debate in the field, not just apply established frameworks. Primary academic sources required.</p></div>
      </div>
      <p>
        A tutoring session focused on command verb coaching gives students a precise, level-specific
        definition of what the verb demands in their unit, with a worked example drawn from their specific
        assignment brief.
      </p>
    </div>
  </section>

  <!-- S6 -->
  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="cmi-resubmission-tutoring">CMI Resubmission Tutoring — After a Referral</h2>
      <p>
        A CMI Referral decision means one or more Learning Outcomes were not met in the original submission.
        Resubmission tutoring focuses specifically on what was unmet and what must change in the rewrite.
        In the majority of Referrals at Level 5 and above, the shortfall is a command verb depth failure.
        The student described when the verb required analysis, or analysed when the verb required evaluation.
      </p>
      <ol class="order-steps">
        <li><strong>Read the assessor feedback precisely.</strong> Identify which Learning Outcomes were marked as not met and what the comments indicate about the nature of the shortfall.</li>
        <li><strong>Map the feedback to the specific command verb or structural gap.</strong> Identifying this precisely tells the student exactly what to change rather than what to add.</li>
        <li><strong>Produce a resubmission plan.</strong> A specific list of what must be added, rewritten, or restructured in each Learning Outcome section, not a general improvement plan.</li>
        <li><strong>Review the revised draft before resubmission.</strong> A post-Referral student who submits a second time without an expert review is taking the same risk twice.</li>
      </ol>
      <p>
        To begin resubmission tutoring, send the original submission, the assessor
        feedback, and the unit brief via WhatsApp.
      </p>
      <div class="order-cta">
        <a href={whatsappUrl} class="btn btn-whatsapp" target="_blank" rel="noopener noreferrer">
          Send Your Brief and Feedback on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- S7 -->
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title" id="tutoring-by-level">Tutoring by Level — What Each Level Requires</h2>
      <div class="levels-table">
        <div class="level-row">
          <div class="level-name"><a href="/cmi-level-3-assignment-help/">CMI Level 3</a><span class="level-units">Most tutored: 301, 302, 303</span></div>
          <div class="level-detail"><span>Primary challenge: structuring an Explain response as a causal chain rather than a description.</span></div>
        </div>
        <div class="level-row">
          <div class="level-name"><a href="/cmi-level-4-assignment-help/">CMI Level 4</a><span class="level-units">Most tutored: 401, 402, 406</span></div>
          <div class="level-detail"><span>Primary challenge: the transition from Explain to Analyse and the shift from essay to management report format.</span></div>
        </div>
        <div class="level-row">
          <div class="level-name"><a href="/cmi-level-5-assignment-help/">CMI Level 5</a><span class="level-units">Most tutored: 501, 502, 503, 512</span></div>
          <div class="level-detail"><span>Primary challenge: Evaluate at full depth, specifically the stated and defended conclusion, and management report structure, especially the executive summary.</span></div>
        </div>
        <div class="level-row">
          <div class="level-name"><a href="/cmi-level-6-assignment-help/">CMI Level 6</a><span class="level-units">Most tutored: 601, 602, 603, 604</span></div>
          <div class="level-detail"><span>Primary challenge: Critically Evaluate at full definition, the framework critique and counter-argument test.</span></div>
        </div>
        <div class="level-row">
          <div class="level-name"><a href="/cmi-level-7-assignment-help/">CMI Level 7</a><span class="level-units">Most tutored: 701, 702, 704, 715</span></div>
          <div class="level-detail"><span>Primary challenge: the shift from operational to strategic register and the requirement for primary academic sources.</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- S8 -->
  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="how-to-book-a-cmi-tutoring-session">How to Book a CMI Tutoring Session</h2>
      <ol class="order-steps">
        <li><strong>Message us on WhatsApp</strong> with your unit number, qualification level, current status (not started, mid-draft, or post-Referral with assessor feedback), and submission deadline. Attach the assignment brief and current draft if one exists.</li>
        <li><strong>Receive a fixed quote within 2 hours.</strong> Sessions are priced by unit and complexity, not by hour.</li>
        <li><strong>Receive your tutoring.</strong> Written guidance, draft review notes, or a live WhatsApp discussion, delivered in the agreed format within the agreed timeframe.</li>
      </ol>
      <div class="order-cta">
        <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
          Message Us to Book
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="cmi-assignment-tutoring-faq">CMI Assignment Tutoring — Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-q">What is the difference between CMI assignment tutoring and your writing service?</summary>
          <div class="faq-a"><p>CMI assignment tutoring is expert coaching where the student writes the assignment. The tutor provides professional direction on command verb requirements, management report structure, framework selection, and Learning Outcome alignment. The student retains authorship of the final submission. The CMI assignment writing service produces the complete submission-ready document on the student's behalf. Both services are available for all levels 3 to 7.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can you tutor me after I have received a CMI Referral?</summary>
          <div class="faq-a"><p>Yes. Post-Referral resubmission tutoring is available for all levels and all units. Send the original submission, the assessor feedback document, and the unit brief via WhatsApp. A fixed quote is provided within two hours.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">How long does a CMI tutoring session take?</summary>
          <div class="faq-a"><p>Sessions are priced by unit and complexity, not by time. Written tutoring guidance is typically delivered within 48 to 72 hours. Live WhatsApp sessions typically run 30 to 60 minutes. Turnaround and format are confirmed at quote stage.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Do you offer tutoring for all CMI levels including Level 7?</summary>
          <div class="faq-a"><p>Yes. Tutoring is available for all levels from 3 to 7 and all Diploma units within each level. Level 7 tutoring addresses Critically Analyse at strategic scope, primary academic source selection, and the register shift from Level 6 to Level 7.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can you review my draft CMI assignment and tell me if I will pass?</summary>
          <div class="faq-a"><p>Yes. Draft review is a core component of the tutoring service. Send the draft, the unit brief, and the level via WhatsApp. The review identifies where the response falls short of Pass, Merit, or Distinction standard and specifies what must change. It does not guarantee an outcome, as your training provider's assessor makes the final decision.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Supplementary -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Related CMI Assignment Services</h2>
      <div class="supp-grid">
        <a href="/cmi-assignment-writing-service/" class="supp-card">
          <h3>CMI Assignment Writing Service</h3>
          <p>Full written delivery for students who need the complete submission-ready assignment produced by a CMI-qualified writer.</p>
        </a>
        <a href="/guides/cmi-command-verbs-explained/" class="supp-card">
          <h3>CMI Command Verbs Explained</h3>
          <p>Every command verb from Identify to Critically Analyse, the foundation of every tutoring session.</p>
        </a>
        <a href="/guides/cmi-assignment-structure/" class="supp-card">
          <h3>CMI Assignment Structure Guide</h3>
          <p>Format planning before writing begins: the nine sections of the management report, and essay and reflective account structure.</p>
        </a>
        <a href="/cmi-level-5-assignment-help/" class="supp-card">
          <h3>CMI Level 5 Assignment Help</h3>
          <p>The most frequently tutored level, Evaluate depth and management report structure.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="cta-section">
    <div class="container cta-inner">
      <h2>Get CMI Tutoring Support</h2>
      <p>Message us on WhatsApp with your unit number, level, and current status. Fixed quote in 2 hours. UK-based CMI tutors across all levels 3 to 7.</p>
      <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
        WhatsApp Us Your Brief
      </a>
    </div>
  </section>

</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--navy) 0%, var(--blue) 100%);
    color: #fff;
    padding: 5rem 0 4rem;
    text-align: center;
  }
  .hero-inner { max-width: 780px; margin: 0 auto; }
  .eyebrow {
    font-size: .8rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .08em; color: #93c5fd; margin-bottom: .75rem;
  }
  .hero h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800;
    color: #fff; margin-bottom: 1.25rem; line-height: 1.2;
  }
  .hero-sub { font-size: 1.05rem; color: #bfdbfe; margin-bottom: 2rem; line-height: 1.7; }
  .hero-note { font-size: .82rem; color: #93c5fd; margin-top: .75rem; }

  .narrow { max-width: 860px; }

  .profile-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
  .profile-card {
    background: #fff; border: 1px solid var(--border); border-radius: 10px;
    padding: 1.5rem; box-shadow: var(--shadow);
  }
  .profile-card--urgent { border-top: 3px solid var(--green-dark); }
  .profile-card h3 { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: .6rem; display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .profile-card p { font-size: .9rem; color: var(--text-muted); line-height: 1.6; margin: 0; }
  .profile-badge {
    font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em;
    background: var(--green); color: #fff; padding: .15rem .5rem; border-radius: 20px;
  }

  .includes-list { display: flex; flex-direction: column; gap: 1rem; list-style: none; padding: 0; }
  .includes-list li {
    padding: 1.25rem 1.5rem; background: var(--bg-light);
    border-left: 4px solid var(--blue); border-radius: 0 var(--radius) var(--radius) 0;
    font-size: .95rem; line-height: 1.65;
  }

  .verb-mini-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.25rem; margin: 1.5rem 0; }
  .verb-mini { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; }
  .verb-mini h3 { font-size: .95rem; font-weight: 700; color: var(--navy); margin-bottom: .5rem; }
  .verb-mini p { font-size: .875rem; color: var(--text-muted); line-height: 1.6; margin: 0; }

  .order-steps {
    display: flex; flex-direction: column; gap: 1rem;
    padding-left: 0; list-style: none; counter-reset: steps; margin-bottom: 1.5rem;
  }
  .order-steps li {
    counter-increment: steps;
    position: relative; padding-left: 3.5rem; min-height: 2.5rem;
    font-size: .95rem; line-height: 1.65;
  }
  .order-steps li::before {
    content: counter(steps);
    display: flex; align-items: center; justify-content: center;
    width: 2.5rem; height: 2.5rem; border-radius: 50%;
    background: var(--blue); color: #fff; font-weight: 700; font-size: 1rem; flex-shrink: 0;
  }
  .order-cta { text-align: center; margin-top: 1.5rem; }

  .levels-table { display: flex; flex-direction: column; gap: .75rem; }
  .level-row { display: grid; grid-template-columns: 220px 1fr; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  .level-name { background: var(--navy); padding: 1.25rem; display: flex; flex-direction: column; gap: .35rem; }
  .level-name a { color: #fff; font-weight: 700; font-size: 1rem; text-decoration: none; }
  .level-name a:hover { text-decoration: underline; }
  .level-units { color: #93c5fd; font-size: .8rem; }
  .level-detail { padding: 1.25rem; background: var(--bg-light); display: flex; align-items: center; }
  .level-detail span { font-size: .88rem; color: var(--text); }

  .faq-list { display: flex; flex-direction: column; gap: .75rem; margin-top: 1.5rem; }
  .faq-item { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  .faq-q {
    display: block; padding: 1.1rem 1.25rem; font-weight: 600; font-size: .975rem;
    color: var(--navy); cursor: pointer; list-style: none; background: var(--bg-light);
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after { content: '+'; float: right; font-size: 1.25rem; font-weight: 400; color: var(--text-muted); }
  .faq-item[open] .faq-q { background: #eff6ff; }
  .faq-item[open] .faq-q::after { content: '−'; }
  .faq-a { padding: 1rem 1.25rem 1.25rem; font-size: .9rem; color: var(--text-muted); line-height: 1.65; }
  .faq-a p { margin: 0; }

