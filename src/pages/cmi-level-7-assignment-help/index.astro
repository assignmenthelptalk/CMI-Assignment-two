const whatsappUrl = 'https://wa.me/447916696894';
const siteUrl = 'https://www.cmiassignmenthelp.uk.com';


const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the word count for a CMI Level 7 assignment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Level 7 sets a guideline word count for each unit. In the August 2026 syllabus it is 4,500 words for Units 701, 702, 705, 708 and 712, 4,000 words for Units 703, 704, 706, 707, 710, 711, 713, 714, 715 and 716, and 3,500 words for Unit 709. The Group B units that count towards Level 7 are 4,000 words for 607, 609, 610 and 612 and 3,500 for 608 and 614. Each has a 10% allowance above or below. The word count on your assignment brief takes precedence over any general guidance."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between CMI Level 7 and a Master's degree?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Both sit at Level 7 of the Regulated Qualifications Framework, the same level as a UK Master's degree. They are different kinds of qualification. A Master's is a university programme with taught modules and usually a dissertation. CMI Level 7 is a professional qualification made up of units, each assessed against CMI's criteria through coursework your centre sets, and graded Pass or Refer. Learners who complete the Diploma or Extended Diploma may be eligible for Chartered Manager with at least three years of management and leadership experience, and CMI lists its Level 8 qualifications as a further progression route."
      }
    },
    {
      "@type": "Question",
      "name": "What does Critically mean in CMI Level 7 criteria?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CMI defines the critical verbs in the syllabus. Critically appraise means a systematic process to identify the strengths and weaknesses of information and judge its usefulness and validity. Critically assess means a reasoned argument based on judgements, considering the validity of the sources used. Critically evaluate means considering strengths and weaknesses and arguments for and against, then reaching a reasoned judgement. Critically reflect means questioning deeply held beliefs and assumptions about your own practice. Of the 80 criteria in Units 701 to 716, 37 begin with Critically, and none uses Critically analyse."
      }
    },
    {
      "@type": "Question",
      "name": "How many sources are needed for a CMI Level 7 assignment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CMI's Level 7 syllabus does not set a minimum number or type of source. It asks for appropriate use of evidence, examples and references to support conclusions and recommendations, and says critical verbs require you to consider the validity of the sources you use. Your centre's brief and referencing guidance apply. Use credible, current sources, including academic research where it supports your argument, and reference them consistently."
      }
    },
    {
      "@type": "Question",
      "name": "Which CMI Level 7 units are available?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CMI lists 16 Group A units at Level 7, numbered 701 to 716, from 701 Strategic Leadership to 716 Strategic Approaches to Mental Health and Wellbeing. Six Level 6 units (607, 608, 609, 610, 612 and 614) are Group B units that can also count. The Award needs at least one Group A unit (7 credits) and the Certificate at least two (14 credits). The Diploma needs 37 credits, at least 30 from Group A and 7 from Group A or B. The Extended Diploma needs 64 credits, at least 42 from Group A and 22 from Group A or B. Your centre confirms which units you take."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide help for a specific CMI Level 7 unit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We cover all 16 Level 7 units, from 701 Strategic Leadership to 716 Strategic Approaches to Mental Health and Wellbeing. Message us on WhatsApp with your unit number, brief and deadline to receive a quote within 2 hours."
      }
    }
  ]
