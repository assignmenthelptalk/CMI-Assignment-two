---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import UnitList from '../../components/UnitList.astro';
import UnitFinder from '../../components/UnitFinder.astro';
import { featuredUnits, allUnitsPath } from '../../data/featuredUnits.js';

const whatsappUrl = 'https://wa.me/447916696894';
const siteUrl = 'https://www.cmiassignmenthelp.uk.com';


const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "CMI Level 3 Assignment Help",
  "description": "Expert CMI Level 3 Principles of Management and Leadership assignment help. All 21 units (301–321) covered. Explain, Identify, Outline and Discuss command verbs, 2,000–2,500-word guideline per unit. UK-based CMI writers.",
  "provider": {
    "@type": "Organization",
    "name": "CMI Assignment Help UK",
    "url": siteUrl
  },
  "areaServed": "United Kingdom",
  "serviceType": "Academic Writing Support",
  "url": siteUrl + "/cmi-level-3-assignment-help/"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What is the word count for a CMI Level 3 assignment?", "acceptedAnswer": { "@type": "Answer", "text": "The guideline word count for CMI Level 3 units in the October 2024 syllabus is 2,000 to 2,500 words, with a 10% allowance above or below. The word count stated on your assignment brief takes precedence over any general guidance." } },
    { "@type": "Question", "name": "Which CMI Level 3 units are available?", "acceptedAnswer": { "@type": "Answer", "text": "CMI lists 21 units at Level 3, numbered 301 to 321, from 301 Principles of Management and Leadership to 321 Managing Own Personal and Professional Development. The units you study depend on the Award, Certificate or Diploma you are taking and the rules of combination your training provider follows." } },
    { "@type": "Question", "name": "How are CMI Level 3 units assessed?", "acceptedAnswer": { "@type": "Answer", "text": "Each unit is assessed against its learning outcomes and assessment criteria, and every criterion must be met. CMI does not state the assessment method for its qualifications, so your centre sets the task. Written work is expected to form the majority of the evidence, and CMI's recommendations for different units include reports, scenarios, short guides and drawing on your own experience. The grade is Pass or Refer." } },
    { "@type": "Question", "name": "How many sources are needed for a CMI Level 3 assignment?", "acceptedAnswer": { "@type": "Answer", "text": "The Level 3 unit specifications don't set a minimum number of sources. The main resource it points to is ManagementDirect, which needs CMI membership. Your centre's brief and referencing guidance apply, so use enough credible sources to support each criterion and reference them consistently." } },
    { "@type": "Question", "name": "Can I get help with a CMI Level 3 resubmission after a Referral?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Send your original submission, the assessor feedback, and your unit brief via WhatsApp. Resubmission support identifies exactly which Learning Outcomes were marked as not met and what must change in the rewrite." } }
  ]
};

---

<Layout
  title="CMI Level 3 Assignment Help - Support & Guidance With Your Units | CMIAssignmentHelp.uk.com"
  description="CMI Level 3 assignment help for all 21 units (301–321). Real syllabus criteria, Pass/Refer grading. UK-based CMI writers, quote in 2 hours."
  canonical={siteUrl + '/cmi-level-3-assignment-help/'}
  pageSchema={[serviceSchema, faqSchema]}
>

  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">UK-Based CMI Writers &bull; Principles of Management and Leadership</p>
      <h1>CMI Level 3 Assignment Help | Principles of Management and Leadership</h1>
      <p class="hero-sub">
        CMI Level 3 Assignment Help covers all 21 units (301–321), from 301 Principles of Management and Leadership to 321 Managing Own
        Personal and Professional Development. Written for team leaders, supervisors, and first-line
        managers by UK-based CMI-qualified writers. Fixed quote in 2 hours.
      </p>
      <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
        Get CMI Level 3 Assignment Help
      </a>
      <p class="hero-note">Fixed quote in 2 hours &bull; All 21 Level 3 units &bull; Award, Certificate, and Diploma</p>
    </div>
  </section>

  <img
    class="page-header-img"
    src="/images/headers/cmi-level-3-assignment-help.webp"
    alt="CMI Level 3 Principles of Management and Leadership assignment help — team leader briefing colleagues in a UK office"
    width="1408"
    height="704"
    loading="eager"
    decoding="async"
  />

  <TableOfContents />

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="what-is-cmi-level-3">What Is CMI Level 3 Principles of Management and Leadership?</h2>
      <p>
        The CMI Level 3 Award, Certificate and Diploma in Principles of Management and Leadership is a management
        qualification from the Chartered Management Institute, positioned at RQF Level 3 in CMI's October 2024 syllabus. The Award needs at least 4 credits, the Certificate at least 13
        credits and the Diploma at least 37 credits, and learners may complete any combination of units to reach them.
       Our CMI Level 3 Assignment Help covers every unit at this level, and is part of <a href="https://www.cmiassignmenthelp.uk.com/">CMI Assignment Help UK</a>, which covers every CMI qualification from Level 3 to Level 7.</p>
      <p>
        The qualification is built for team leaders, supervisors, and first-line managers,
        professionals responsible for the day-to-day management of a team but not yet operating at
        departmental or strategic scope. 21 units are available, numbered 301 to 321, covering
        foundational first-line management responsibilities: leadership principles, team performance,
        individual development, communication, stakeholder relationships, equality and inclusion,
        budgets, projects, and data.
      </p>
      <p>
        Every unit is assessed against its specific learning outcomes and assessment criteria. CMI's grading
        system is Pass or Refer, and every criterion must be met for a Pass.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title" id="all-21-units">Find Your CMI Level 3 Unit (301–321)</h2>
      <p class="section-lead">
        CMI lists 21 units at Level 3, numbered 301 to 321. Choose yours below or open the full list.
        Assignment help is available for every unit: send your unit number and brief via WhatsApp.
      </p>

      <UnitFinder level={3} />

      <UnitList level={3} only={featuredUnits[3]} lead="Featured Level 3 units:" allHref={siteUrl + allUnitsPath(3)} allLabel="See all 21 CMI Level 3 units" />
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="how-cmi-level-3-units-are-assessed">How CMI Level 3 Units Are Assessed</h2>
      <p>
        CMI does not state the assessment method for its qualifications. Instead, centres create assessment plans to
        suit learners and employers, so the task you receive depends on your centre. The syllabus says written work is
        expected to form the majority of assessable work at Level 3, and its recommendations for individual units
        include responding to a scenario, writing a report, producing a short guide, or drawing on your own experience
        with work-based evidence. Unit 320, Presenting for Success, also requires you to deliver a presentation.
      </p>
      <p>
        The guideline word count for Level 3 units is 2,000 to 2,500 words, with a 10% allowance above or below.
        CMI asks learners to keep appendices to a minimum and to put essential information in the main body of
        the work. Your brief takes precedence over any general guidance. See the
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-assignment-structure/">CMI assignment structure guide</a> for advice on
        structuring written work.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="command-verbs">Command Verbs at CMI Level 3</h2>
      <p>The first word of each criterion sets the depth of answer. Across the 21 Level 3 units, most criteria ask you to explain, identify, outline or discuss. Always follow the verb on your own criteria and brief.</p>
      <div class="verb-mini-grid">
        <div class="verb-mini"><h3>Explain</h3><p>The most common verb, used in 112 criteria. Give reasons: say how and why, not just what.</p></div>
        <div class="verb-mini"><h3>Identify and Outline</h3><p>Used 38 and 33 times. Name the relevant items, or give the main points briefly, with an example from work.</p></div>
        <div class="verb-mini"><h3>Summarise and Define</h3><p>Give the key points in a short, accurate form, or state exactly what a term means.</p></div>
        <div class="verb-mini"><h3>Discuss</h3><p>Used 27 times. Set out different viewpoints or considerations and reach a reasoned position.</p></div>
        <div class="verb-mini"><h3>Assess and Compare</h3><p>Weigh up importance or effect, or set things side by side to show how they are alike and different.</p></div>
      </div>
      <p class="worked-note">
        <strong>Identify vs Explain (Unit 302):</strong> "Methods of monitoring team performance include progress
        reports and key performance indicators" is Identify (AC5.3). "Progress reports show whether work is on
        schedule, so a manager can step in early, while KPIs make performance comparable over time" is Explain.
        See the full
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-command-verbs-explained/">CMI command verbs explained</a> guide for every
        verb across all levels.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="how-cmi-level-3-is-graded">How CMI Level 3 Is Graded: Pass or Refer</h2>
      <p class="section-lead">CMI Level 3 units are graded Pass or Refer. There is no Merit or Distinction.</p>
      <p>
        Your work is checked against the assessment criteria of each unit, and every criterion has to be met for a
        Pass. Meeting a criterion means doing what its verb asks, with relevant evidence and examples from work.
        A Refer means at least one criterion is not yet met. CMI says work can be submitted up to three times through
        its external marking service, and our
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-resubmission-guide/">CMI resubmission guide</a>
        explains what to do after a Refer.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="pathway-to-level-4">Pathway from CMI Level 3 to CMI Level 4</h2>
      <p>
        Completing CMI Level 3 is the natural route into
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-4-assignment-help/">CMI Level 4 assignment help</a>, Management and
        Leadership, for managers with department-level or cross-team responsibility.
      </p>
      <p>
        Level 4 units cover managerial styles, stakeholders, organisational culture, teams, report writing,
        influencing and interviews. Its criteria lean on Describe, Discuss, Identify and Explain, with Evaluate and
        Analyse in a smaller number, and each Level 4 unit has a 3,000-word guideline.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="section-title" id="how-to-get-help">How to Get CMI Level 3 Assignment Help</h2>
      <ol class="order-steps">
        <li><strong>Message us on WhatsApp</strong> with your unit number (e.g., Unit 301 or Unit 302), your submission deadline, and a copy of your assignment brief.</li>
        <li><strong>Receive a fixed quote within 2 hours.</strong> No hidden fees for referencing or revisions.</li>
        <li><strong>A CMI Level 3 qualified writer</strong> produces your submission-ready assignment, written to your brief and unit criteria with referencing and workplace application built in.</li>
      </ol>
      <div class="order-cta">
        <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
          Order on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2 class="section-title" id="level-3-faq">CMI Level 3 Assignment Help — Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item"><summary class="faq-q">What is the word count for a CMI Level 3 assignment?</summary><div class="faq-a"><p>The guideline word count for CMI Level 3 units in the October 2024 syllabus is 2,000 to 2,500 words, with a 10% allowance above or below. The word count stated on your assignment brief takes precedence over any general guidance.</p></div></details>
        <details class="faq-item"><summary class="faq-q">Which CMI Level 3 units are available?</summary><div class="faq-a"><p>CMI lists 21 units at Level 3, numbered 301 to 321, from 301 Principles of Management and Leadership to 321 Managing Own Personal and Professional Development. Which ones you study depends on whether you are taking the Award, Certificate or Diploma and on your training provider's rules of combination.</p></div></details>
        <details class="faq-item"><summary class="faq-q">How are CMI Level 3 units assessed?</summary><div class="faq-a"><p>Each unit is assessed against its learning outcomes and assessment criteria, and every criterion must be met. CMI does not state the assessment method for its qualifications, so your centre sets the task. Written work is expected to form the majority of the evidence, and CMI's recommendations for different units include reports, scenarios, short guides and drawing on your own experience. The grade is Pass or Refer.</p></div></details>
        <details class="faq-item"><summary class="faq-q">How many sources are needed for a CMI Level 3 assignment?</summary><div class="faq-a"><p>The Level 3 unit specifications don't set a minimum number of sources. The main resource it points to is ManagementDirect, which needs CMI membership. Your centre's brief and referencing guidance apply, so use enough credible sources to support each criterion and reference them consistently.</p></div></details>
        <details class="faq-item"><summary class="faq-q">Can I get help with a CMI Level 3 resubmission after a Referral?</summary><div class="faq-a"><p>Yes. Send your original submission, the assessor feedback, and your unit brief via WhatsApp. Resubmission support identifies exactly which Learning Outcomes were unmet and what must change in the rewrite.</p></div></details>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Related CMI Assignment Services</h2>
      <div class="supp-grid">
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-assignment-writing-service/" class="supp-card"><h3>CMI Assignment Writing Service</h3><p>Full delivery for all 21 Level 3 units and every other CMI level.</p></a>
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-4-assignment-help/" class="supp-card"><h3>CMI Level 4 Assignment Help</h3><p>The natural progression from Level 3: nine Level 4 coded units (4001 to 4009), plus three Level 5 coded units in the Diploma.</p></a>
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-assignment-tutoring/" class="supp-card"><h3>CMI Assignment Tutoring</h3><p>For Level 3 students who want to write their own assignment with expert guidance.</p></a>
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-command-verbs-explained/" class="supp-card"><h3>CMI Command Verbs Explained</h3><p>Every verb in the CMI hierarchy, including Explain, Identify, Outline and Discuss at Level 3.</p></a>
      </div>
    </div>
  </section>




  <section class="section">
    <div class="container">
      <h2 class="section-title" id="guides-for-level-3">Guides for CMI Level 3</h2>
      <p class="section-lead">
        These guides cover the skills that Level 3 units test. Start with the structure and command verbs guides.
      </p>
      <div class="supp-grid">
        <a href="https://www.cmiassignmenthelp.uk.com/guides/harvard-referencing-cmi/" class="supp-card">
          <h3>Harvard Referencing for CMI Assignments</h3>
          <p>How to cite and reference. The unit specifications don't set a minimum number of sources, so use enough credible ones to support each criterion.</p>
        </a>
        <a href="https://www.cmiassignmenthelp.uk.com/guides/management-theory-cmi-assignments/" class="supp-card">
          <h3>Management Theory for CMI Assignments</h3>
          <p>How to apply and test frameworks such as Tuckman, Belbin, Kotter and Lewin, which Level 3 indicative content names.</p>
        </a>
        <a href="https://www.cmiassignmenthelp.uk.com/guides/nhs-management-cmi-qualifications/" class="supp-card">
          <h3>CMI Qualifications for NHS Managers</h3>
          <p>Choosing a CMI level by the scope of your role rather than your pay band.</p>
        </a>
        <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-membership-levels-acmi-mcmi-fcmi/" class="supp-card">
          <h3>CMI Membership Grades: ACMI, MCMI and FCMI</h3>
          <p>ACMI, MCMI and FCMI are membership grades, not qualifications. How each is earned.</p>
        </a>
        <a href="https://www.cmiassignmenthelp.uk.com/guides/is-cmi-qualification-worth-it/" class="supp-card">
          <h3>Is a CMI Qualification Worth It?</h3>
          <p>A balanced look at cost, time and what the evidence does and does not show.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title" id="other-cmi-levels">Other CMI Levels</h2>
      <p class="section-lead">
        CMI qualifications run from Level 3 to Level 7, and the right level depends on the scope of your role.
        See <a href="https://www.cmiassignmenthelp.uk.com/guides/cmi-qualification-levels-explained/">CMI qualification levels explained</a> for how they compare.
      </p>
      <div class="supp-grid">
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-4-assignment-help/" class="supp-card">
          <h3>CMI Level 4 Assignment Help</h3>
          <p>Management and Leadership. Units 4001 to 4009. Develops management capability, decision-making and managing people, with Describe, Discuss and Identify leading the criteria.</p>
        </a>
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-5-assignment-help/" class="supp-card">
          <h3>CMI Level 5 Assignment Help</h3>
          <p>Management and Leadership. Units 501 to 526. For managers accountable to a senior manager, with Analyse, Examine and Evaluate leading the criteria.</p>
        </a>
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-6-assignment-help/" class="supp-card">
          <h3>CMI Level 6 Assignment Help</h3>
          <p>Professional Management and Leadership Practice. Units 601 to 614. Between Levels 5 and 7, with Critically appraise and Critically assess leading the criteria.</p>
        </a>
        <a href="https://www.cmiassignmenthelp.uk.com/cmi-level-7-assignment-help/" class="supp-card">
          <h3>CMI Level 7 Assignment Help</h3>
          <p>Strategic Management and Leadership Practice. Units 701 to 716. For senior managers and directors, with 37 of 80 criteria beginning Critically.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-inner">
      <h2>WhatsApp Us Your Unit Number</h2>
      <p>Message us with your unit number, deadline, and brief. Fixed quote in 2 hours. UK-based CMI writers for all 21 Level 3 units.</p>
      <a href={whatsappUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">
        Get CMI Level 3 Assignment Help
      </a>
    </div>
  </section>

</Layout>

<style>
  .hero { background: var(--hero-bg); color: var(--navy); padding: 5rem 0 4rem; text-align: center; }
  .hero-inner { max-width: 780px; margin: 0 auto; }
  .eyebrow { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--blue); margin-bottom: .75rem; }
  .hero h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; color: var(--navy); margin-bottom: 1.25rem; line-height: 1.2; }
  .hero-sub { font-size: 1.05rem; color: var(--text); margin-bottom: 2rem; line-height: 1.7; }
  .hero-note { font-size: .82rem; color: var(--blue); margin-top: .75rem; }

  .narrow { max-width: 860px; }

  .unit-list { display: flex; flex-direction: column; gap: 1rem; }
  .unit-item { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--border); }
  .unit-item--priority { background: var(--bg-light); border-radius: var(--radius); padding: 1rem; border-bottom: none; --text-muted: var(--text); }
  .unit-number { font-size: 1.4rem; font-weight: 800; color: var(--blue); text-align: center; }
  .unit-title { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: .35rem; display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .unit-badge { font-size: .65rem; font-weight: 700; text-transform: uppercase; background: var(--green); color: var(--navy); padding: .15rem .5rem; border-radius: 20px; }
  .unit-desc { font-size: .88rem; color: var(--text-muted); line-height: 1.6; margin: 0; }
  .unit-note { font-size: .85rem; color: var(--text-muted); margin-top: 1rem; font-style: italic; }

  .essay-parts { display: flex; flex-direction: column; gap: .9rem; padding-left: 1.25rem; }
  .essay-parts li { font-size: .95rem; line-height: 1.6; }

  .verb-mini-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.25rem; margin: 1.5rem 0; }
  .verb-mini { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; }
  .verb-mini h3 { font-size: .95rem; font-weight: 700; color: var(--navy); margin-bottom: .5rem; }
  .verb-mini p { font-size: .875rem; color: var(--text-muted); line-height: 1.6; margin: 0; }

  .worked-note { font-size: .9rem; color: var(--text); background: var(--bg-light); border-left: 4px solid var(--accent); padding: 1rem 1.25rem; border-radius: 0 var(--radius) var(--radius) 0; line-height: 1.65; --text-muted: var(--text); }

  .grade-blocks { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; }
  .grade-block { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; }
  .grade-block h3 { font-size: .85rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); margin-bottom: .6rem; }
  .grade-merit { border-top: 3px solid var(--accent); }
  .grade-merit h3 { color: var(--blue); }
  .grade-distinction { border-top: 3px solid var(--navy); }
  .grade-distinction h3 { color: var(--navy); }
  .grade-block p { font-size: .88rem; color: var(--text); line-height: 1.6; margin: 0; }

  .order-steps { display: flex; flex-direction: column; gap: 1rem; padding-left: 0; list-style: none; counter-reset: steps; margin-bottom: 1.5rem; }
  .order-steps li { counter-increment: steps; position: relative; padding-left: 3.5rem; min-height: 2.5rem; font-size: .95rem; line-height: 1.65; }
  .order-steps li::before { content: counter(steps); display: flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--blue); color: #fff; font-weight: 700; font-size: 1rem; position: absolute; left: 0; top: 0; }
  .order-cta { text-align: center; }

  .faq-list { display: flex; flex-direction: column; gap: .75rem; margin-top: 1.5rem; }
  .faq-item { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  .faq-q { display: block; padding: 1.1rem 1.25rem; font-weight: 600; font-size: .975rem; color: var(--navy); cursor: pointer; list-style: none; background: var(--bg-light); --text-muted: var(--text); }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after { content: '+'; float: right; font-size: 1.25rem; font-weight: 400; color: var(--text-muted); }
  .faq-item[open] .faq-q { background: var(--hero-tint); --text-muted: var(--text); }
  .faq-item[open] .faq-q::after { content: '−'; }
  .faq-a { padding: 1rem 1.25rem 1.25rem; font-size: .9rem; color: var(--text-muted); line-height: 1.65; }
  .faq-a p { margin: 0; }

  .supp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem; }
  .supp-card { display: block; padding: 1.5rem; background: #fff; border: 1px solid var(--border); border-radius: 10px; text-decoration: none; color: var(--text); box-shadow: var(--shadow); transition: border-color .15s, transform .1s; }
  .supp-card:hover { border-color: var(--accent); transform: translateY(-2px); text-decoration: none; color: var(--text); }
  .supp-card h3 { font-size: .975rem; font-weight: 700; color: var(--navy); margin-bottom: .5rem; }
  .supp-card p { font-size: .875rem; color: var(--text-muted); line-height: 1.55; margin: 0; }

  .cta-section { background: var(--cta-bg); padding: 4rem 0; }
  .cta-inner { text-align: center; max-width: 680px; margin: 0 auto; }
  .cta-inner h2 { font-size: 2rem; font-weight: 700; color: #fff; margin-bottom: 1rem; }
