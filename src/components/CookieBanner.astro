---
// Consent banner for Google Analytics. Nothing from Google is requested and no analytics cookie is
// set until the visitor clicks Accept. The choice is kept in localStorage under `cmi-consent`
// (never in a cookie) and asked again after 6 months. Google consent mode is not used.
// Without JavaScript the banner stays hidden and analytics never loads.
const privacyUrl = 'https://www.cmiassignmenthelp.uk.com/privacy-policy/';
---

<div
  id="cookie-banner"
  class="cookie-banner"
  role="dialog"
  aria-labelledby="cookie-banner-title"
  aria-describedby="cookie-banner-text"
  tabindex="-1"
  hidden
>
  <p id="cookie-banner-title" class="cookie-banner-title">Cookies</p>
  <p id="cookie-banner-text" class="cookie-banner-text">
    We&rsquo;d like to use Google Analytics cookies to count visits and see which pages are used.
    They are optional and only start if you accept.
    <a href={privacyUrl}>Privacy Policy</a>
  </p>
  <div class="cookie-banner-actions">
    <button type="button" class="cookie-btn" data-cookie-choice="granted">Accept analytics</button>
    <button type="button" class="cookie-btn" data-cookie-choice="denied">Reject</button>
  </div>
</div>

<script is:inline>
(function(){
var ID='G-NVSRJ51S2S',K='cmi-consent',on=0,op,b=document.getElementById('cookie-banner');
function get(){try{var c=JSON.parse(localStorage.getItem(K)),d=new Date(c.date);d.setMonth(d.getMonth()+6);
if((c.choice=='granted'||c.choice=='denied')&&Date.now()<d)return c.choice}catch(e){}}
function ga(){if(on)return;on=1;window['ga-disable-'+ID]=false;window.dataLayer=window.dataLayer||[];
window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date);gtag('config',ID);
var s=document.createElement('script');s.async=1;s.src='https://www.googletagmanager.com/gtag/js?id='+ID;document.head.appendChild(s)}
function wipe(){var h=location.hostname.split('.'),d=[''],i,x;
for(i=0;i<h.length-1;i++){x=h.slice(i).join('.');d.push(x,'.'+x)}
['_ga','_ga_'+ID.slice(2)].forEach(function(n){d.forEach(function(x){
document.cookie=n+'=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/'+(x?';domain='+x:'')})})}
function pad(){document.body.style.paddingBottom=!b.hidden&&matchMedia('(max-width:640px)').matches?b.offsetHeight+'px':''}
function show(f){b.hidden=false;pad();if(f)b.focus()}
function pick(v){try{localStorage.setItem(K,JSON.stringify({choice:v,date:new Date().toISOString()}))}catch(e){}
b.hidden=true;pad();
if(v=='granted')ga();else{window['ga-disable-'+ID]=true;wipe();if(on){location.reload();return}}
if(op)op.focus();op=0}
function init(){var v=get();
if(v=='granted')ga();else{wipe();if(!v)show()}
b.addEventListener('click',function(e){var t=e.target.closest('[data-cookie-choice]');if(t)pick(t.getAttribute('data-cookie-choice'))});
document.querySelectorAll('[data-cookie-settings]').forEach(function(el){el.hidden=false;
el.addEventListener('click',function(){op=el;show(1)})})}
document.readyState=='loading'?document.addEventListener('DOMContentLoaded',init):init()
})();
</script>

<style is:global>
  .cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 250;
    background: var(--bg);
    color: var(--text);
    border-top: 1px solid var(--border-strong);
    box-shadow: 0 -4px 6px -1px rgba(0, 0, 0, .1);
    padding: 1rem 1rem calc(1rem + env(safe-area-inset-bottom, 0px));
    font-size: .95rem;
    line-height: 1.5;
  }
  .cookie-banner[hidden] { display: none; }
  .cookie-banner:focus { outline: none; }
  .cookie-banner:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: -3px; }
  .cookie-banner-title { margin: 0 0 .25rem; font-weight: 700; color: var(--navy); }
  .cookie-banner-text { margin: 0 0 .75rem; }
  .cookie-banner-text a { color: var(--blue); text-decoration: underline; text-underline-offset: 2px; }
  .cookie-banner-actions { display: flex; gap: .75rem; }
  .cookie-btn {
    flex: 1 1 0;
    min-height: 44px;
    padding: .6rem 1rem;
    border: 2px solid var(--blue);
    border-radius: var(--radius);
    background: var(--blue);
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .cookie-btn:hover { background: var(--accent-strong-hover); border-color: var(--accent-strong-hover); }
  .cookie-btn:focus-visible,
  .cookie-banner-text a:focus-visible,
  .cookie-settings-link:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 2px; }

  /* "Cookie settings" control: hidden until the script confirms it can work */
  .cookie-settings-link {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--blue-light);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }
  .cookie-settings-link[hidden] { display: none; }
  .footer-links .cookie-settings-link { color: var(--footer-text); font-size: .875rem; text-decoration: none; }
  .footer-links .cookie-settings-link:hover { color: var(--bg); text-decoration: underline; }
  .footer-links .cookie-settings-link:focus-visible { outline-color: var(--focus-ring-on-dark); }

  @media (min-width: 641px) {
    .cookie-banner {
      right: auto;
      left: 1rem;
      bottom: 1rem;
      width: 420px;
      max-width: calc(100vw - 2rem);
      border: 1px solid var(--border-strong);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      box-shadow: var(--shadow);
    }
  }
</style>
