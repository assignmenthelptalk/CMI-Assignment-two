---
// "Find my unit": level dropdown (3 to 7) filters a unit dropdown, and a button opens that unit's page.
// Data: src/data/units.json (codes from the parsed CMI syllabuses). A unit links to its page only when the
// page exists in the build; otherwise the selector shows a message with a WhatsApp link.
// Without JavaScript the form stays hidden and plain links to the five level pages show instead.
import units from '../data/units.json';

const BASE = 'https://www.cmiassignmenthelp.uk.com';
const WHATSAPP = 'https://wa.me/447916696894';
const levels = [3, 4, 5, 6, 7] as const;

const pageFiles = Object.keys(import.meta.glob('../pages/cmi-*-assignment-help/index.md'));
const existing = new Set(pageFiles.map((f) => (f.match(/cmi-(\d+)-assignment-help/) || [])[1]));

// { "3": [[code, title, hasPage 1|0], ...], ... }
const data = Object.fromEntries(
  levels.map((l) => [l, (units as Record<string, string[][]>)[String(l)].map(([code, title]) => [code, title, existing.has(code) ? 1 : 0])])
);
const dataJson = JSON.stringify(data).replace(/</g, '\\u003c');
---
<div class="unit-finder" data-unit-finder data-base={BASE} data-wa={WHATSAPP}>
  <h2 class="uf-title" id="uf-title">Find my unit</h2>

  <form class="uf-form" aria-labelledby="uf-title" hidden novalidate>
    <div class="uf-field">
      <label for="uf-level">CMI level</label>
      <select id="uf-level" name="level">
        <option value="">Choose a level</option>
        {levels.map((l) => <option value={l}>Level {l}</option>)}
      </select>
    </div>
    <div class="uf-field uf-field--unit">
      <label for="uf-unit">Unit</label>
      <select id="uf-unit" name="unit" disabled>
        <option value="">Choose a level first</option>
      </select>
    </div>
    <button type="submit" class="btn uf-btn">Go to unit page</button>
    <p class="uf-msg" role="status" aria-live="polite"></p>
  </form>

  <p class="uf-fallback" data-uf-fallback>
    Choose your level:
    {levels.map((l, i) => (
      <>{i > 0 && ' · '}<a href={`${BASE}/cmi-level-${l}-assignment-help/`}>Level {l}</a></>
    ))}
  </p>

  <script type="application/json" id="uf-data" set:html={dataJson}></script>
</div>

<script>
  const root = document.querySelector('[data-unit-finder]');
  if (root) {
    const data = JSON.parse(root.querySelector('#uf-data').textContent);
    const form = root.querySelector('.uf-form');
    const fallback = root.querySelector('[data-uf-fallback]');
    const levelSel = form.querySelector('#uf-level');
    const unitSel = form.querySelector('#uf-unit');
    const msg = form.querySelector('.uf-msg');
    const base = root.dataset.base;
    const whatsapp = root.dataset.wa;

    const clearMessage = () => { msg.textContent = ''; msg.classList.remove('uf-msg--warn'); };
    const say = (text, warn) => { clearMessage(); msg.textContent = text; msg.classList.toggle('uf-msg--warn', !!warn); };
    const currentUnit = () => (data[levelSel.value] || []).find((u) => u[0] === unitSel.value);

    const sayNoPage = (unit) => {
      clearMessage();
      msg.append(`We don't have a page for Unit ${unit[0]} yet, but we can still help. `);
      const a = document.createElement('a');
      a.href = `${whatsapp}?text=${encodeURIComponent(`Hi, I need help with CMI Unit ${unit[0]} (${unit[1]})`)}`;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = 'Message us on WhatsApp';
      msg.append(a, '.');
    };

    levelSel.addEventListener('change', () => {
      clearMessage();
      unitSel.replaceChildren();
      const units = data[levelSel.value];
      const first = new Option(units ? 'Choose a unit' : 'Choose a level first', '');
      unitSel.add(first);
      if (units) units.forEach((u) => unitSel.add(new Option(`${u[0]} – ${u[1]}`, u[0])));
      unitSel.disabled = !units;
    });

    unitSel.addEventListener('change', () => {
      const unit = currentUnit();
      if (unit && !unit[2]) sayNoPage(unit); else clearMessage();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!levelSel.value) { say('Choose a level first.', true); levelSel.focus(); return; }
      const unit = currentUnit();
      if (!unit) { say('Choose a unit.', true); unitSel.focus(); return; }
      if (!unit[2]) { sayNoPage(unit); return; }
      if (typeof gtag === 'function') gtag('event', 'find_unit_click', { unit_code: unit[0], unit_level: levelSel.value });
      window.location.assign(`${base}/cmi-${unit[0]}-assignment-help/`);
    });

    form.hidden = false;
    fallback.hidden = true;
  }
</script>

<style>
  .unit-finder {
    margin: 0 auto 1.25rem;
    padding: 1.1rem 1.25rem 1.25rem;
    max-width: 640px;
    text-align: left;
    background: rgba(255, 255, 255, .12);
    border: 1px solid rgba(255, 255, 255, .25);
    border-radius: 12px;
  }
  .uf-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 .75rem;
    text-align: center;
  }
  .uf-form {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem 1rem;
    align-items: flex-end;
    justify-content: center;
  }
  .uf-form[hidden], .uf-fallback[hidden] { display: none; }
  .uf-field { display: flex; flex-direction: column; gap: .3rem; flex: 0 1 11rem; min-width: 0; }
  .uf-field--unit { flex: 1 1 16rem; }
  .uf-field label { font-size: .85rem; font-weight: 600; color: #dbeafe; }
  .uf-field select {
    width: 100%;
    min-height: 44px;
    padding: .55rem .75rem;
    font: inherit;
    font-size: 1rem;
    color: #1f2937;
    background: #fff;
    border: 2px solid transparent;
    border-radius: 8px;
  }
  .uf-field select:disabled { background: #e5e7eb; color: #4b5563; }
  .uf-btn {
    min-height: 44px;
    padding: .55rem 1.4rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
    background: #fff;
    border: 2px solid #fff;
  }
  .uf-btn:hover { background: #dbeafe; border-color: #dbeafe; }
  .uf-form select:focus-visible,
  .uf-btn:focus-visible,
  .uf-msg a:focus-visible,
  .uf-fallback a:focus-visible {
    outline: 3px solid #fbbf24;
    outline-offset: 2px;
  }
  .uf-msg { flex: 1 1 100%; margin: 0; font-size: .92rem; line-height: 1.5; color: #fff; text-align: center; }
  .uf-msg:empty { display: none; }
  .uf-msg--warn { color: #fde68a; }
  .uf-msg a, .uf-fallback a { color: #fff; font-weight: 600; text-decoration: underline; }
  .uf-fallback { margin: 0; font-size: .95rem; color: #dbeafe; text-align: center; }

  @media (max-width: 720px) {
    .unit-finder { padding: 1rem; }
    .uf-field, .uf-field--unit { flex: 1 1 100%; }
    .uf-btn { width: 100%; }
  }
</style>
